# 50 sources: the sources on and off the machine (blueprint §3, §10.1), read two ways.
#
# spec-for (meaning blueprint §5.2, §8): a meaning needs a spec. The brain asks a source for a
# gate's definitions and hears each one WHOLE through the encoder, one sense (or one sentence
# of a long one) to a reading run. What it heard goes into the gate's sec-sources as a heard
# gate list, after the source it came from, with this run's receipt. That is the spec: a
# description its meaning has to live up to, never the meaning, and never a line per word.
# Two sources when it can. Then the gate goes on GAP for the meaning loop (mean, 73).
#
# source-check (§10.2): check-and-diff for what a source ASSERTS as a relation (WordNet's
# antonym, hypernym, holonym, synonym, cause; a thesaurus's synonyms and antonyms). Each term
# is diffed against what the gate holds: the same -> strength up; new -> a line added;
# different -> a sense of its own, or a contradiction for belief. A gap is a gap.
#
# Neither is a reflex of birth: a word is read when a meaning or a question needs it.
#
# A port only fetches and flattens. It queues what the source gave, one entry a line (a
# line past 60 words breaks at its sentences), every entry: no first sense, no cut, no stop
# words; the kernel's CALL-CAP is the only byte cap on an answer. It answers with the
# queue's path; each reading run hands that back to a reader port (src-spec-next /
# src-rel-next) and gets the next line. Nothing here is a fact; it is how to reach a source.

# gates other areas define
gate mean
gate belief
gate ask-name

# the source gates
gate src-wn-ant
gate src-wn-hype
gate src-wn-holo
gate src-wn-syn
gate src-wn-cause
gate src-mw-syn
gate src-mw-ant
gate src-wn-def
gate src-gcide
gate src-foldoc
gate src-elements
gate src-man
gate src-mw-coll
gate src-openstax
gate src-wiktionary
gate src-wikipedia
gate src-moby
gate src-wikidata
gate src-oeis
gate src-codata
gate src-godoc
gate src-oewn-def
gate src-oewn-syn
gate src-oewn-ant
gate src-vera
gate src-fd-eng-fra
gate src-roget
gate src-sep
gate src-eb1911
gate src-mathworld
gate src-pubchem
gate src-uniprot
gate src-gbif
gate src-itis
gate src-sbdb
gate src-medlineplus
gate src-ncbi-books
gate src-rfc
gate src-unicode
gate src-pubmed
gate src-europepmc
gate src-arxiv
gate src-nominatim
gate src-mdn
gate src-openlibrary
gate src-internetarchive
gate src-spec-next
gate src-rel-next
# ---- the ports for asserted relations (source-check reads these)
source src-wn-ant grounded "wn %s -antsn -antsv -antsa -antsr 2>/dev/null | awk '/^Sense/{print o; o=\"\"; n=1; next} /^$/{n=0} n&&/=>/{sub(/^ *=> */,\"\"); o=o $0 \", \"; next} n&&/\\(vs\\. /{s=$0; sub(/.*\\(vs\\. /,\"\",s); sub(/\\).*/,\"\",s); o=o s \", \"} END{print o}' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/wn-ant; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-wn-hype grounded "wn %s -hypen -hypev 2>/dev/null | awk '/^Sense/{print o; o=\"\"; next} match($0,/^ *=> /) && RLENGTH==10 {sub(/^ *=> /,\"\"); o=o $0 \", \"} END{print o}' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/wn-hype; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-wn-holo grounded "wn %s -holon 2>/dev/null | awk '/^Sense/{print o; o=\"\"; next} /^ *(PART|MEMBER|SUBSTANCE) OF: /{sub(/^ *[A-Z]+ OF: /,\"\"); o=o $0 \", \"} END{print o}' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/wn-holo; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-wn-syn grounded "wn %s -synsn -synsv -synsa -synsr 2>/dev/null | awk '/^Sense/{getline; sub(/\\(vs\\..*/,\"\"); print}' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/wn-syn; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-wn-cause grounded "wn %s -causv 2>/dev/null | awk '/^Sense/{print o; o=\"\"; next} match($0,/^ *=> /) && RLENGTH==10 {sub(/^ *=> /,\"\"); o=o $0 \", \"} END{print o}' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/wn-cause; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-mw-syn grounded "K=$(cat /home/neuron/.config/merriam-webster/mw_thesaurus.key 2>/dev/null); [ ${#K} -gt 0 ] && curl -s -m 15 https://www.dictionaryapi.com/api/v3/references/thesaurus/json/$(jq -rn --arg w %s '$w|@uri')?key=$K | jq -r '.[]? | objects | .meta.syns[]? | join(\", \")' 2>/dev/null | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/mw-syn; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-mw-ant grounded "K=$(cat /home/neuron/.config/merriam-webster/mw_thesaurus.key 2>/dev/null); [ ${#K} -gt 0 ] && curl -s -m 15 https://www.dictionaryapi.com/api/v3/references/thesaurus/json/$(jq -rn --arg w %s '$w|@uri')?key=$K | jq -r '.[]? | objects | .meta.ants[]? | join(\", \")' 2>/dev/null | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/mw-ant; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-moby grounded "curl -s -m 15 dict://dict.org/d:%s:moby-thesaurus | tr -d '\\r' | sed -n '/^151/,/^\\.$/p' | sed '1,2d;$d' | tr '\\n' ' ' | tr ',' '\\n' | awk 'NF{o=o $0 \",\"; n++} n==20{print o; o=\"\"; n=0} END{print o}' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/moby; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-oewn-syn grounded "exec 2>/dev/null; WNSEARCHDIR=/srv/sources/wordnet/oewn-2025/english-wordnet-2025/oewn2025 wn %s -synsn -synsv -synsa -synsr 2>/dev/null | awk '/^Sense [0-9]+$/{n=0;i=1;next} /^[0-9]+ senses? of /||/ of (noun|verb|adj|adv) /{i=0;next} i&&/^[^ \\t]/{n++; if(n==1) print}' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/oewn-syn; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
source src-oewn-ant grounded "exec 2>/dev/null; WNSEARCHDIR=/srv/sources/wordnet/oewn-2025/english-wordnet-2025/oewn2025 wn %s -antsn -antsv -antsa -antsr 2>/dev/null | awk '/^Sense [0-9]+$/{n=0;i=1;next} /^[0-9]+ senses? of /||/ of (noun|verb|adj|adv) /{i=0;next} i&&/^[^ \\t]/{n++; if(n==2) print}' | sed 's/^INDIRECT.*-> //' | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | { d=rel/oewn-ant; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ $(wc -l < $f) -gt 1 ] && sed -i 's/$/ #/' $f; [ -s $f ] && echo $f; }"
# ---- the ports for definitions (spec-for reads these)
source src-wn-def grounded "dict -d wn %s 2>/dev/null | sed '1,4d' | awk '/^ *(n|v|adj|adv)? *[0-9]*: /{if(i)print s; i=1; s=$0; sub(/^ *(n|v|adj|adv)? *[0-9]*: /,\"\",s); next} i{s=s \" \" $0} END{if(i)print s}' | sed 's/\\[[^]]*\\]//g' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/wn-def; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-oewn-def grounded "exec 2>/dev/null; WNSEARCHDIR=/srv/sources/wordnet/oewn-2025/english-wordnet-2025/oewn2025 wn %s -over 2>/dev/null | grep -E '^[0-9]+\\. ' | sed 's/^[0-9]*\\. ([0-9]*) //;s/^[0-9]*\\. //' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/oewn-def; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-gcide grounded "dict -d gcide %s 2>/dev/null | sed '1,4d' | grep -v '^From ' | tr '\\n' ' ' | sed 's/\\[[^]]*\\]//g;s/\\\\[^\\\\]*\\\\//g;s/--[A-Z][a-z]*\\.//g;s/ [0-9]\\{1,2\\}\\. /\\n/g' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/gcide; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-foldoc grounded "dict -d foldoc %s 2>/dev/null | sed '1,4d' | tr '\\n' ' ' | sed 's/<[^>]*>//g;s/([0-9-]*)//g;s/ [0-9]\\{1,2\\}\\. /\\n/g' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/foldoc; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-elements grounded "dict -d elements %s 2>/dev/null | sed '1,4d' | tr '\\n' ' ' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/elements; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-man grounded "man -P cat %s 2>/dev/null | col -b | awk '/^[A-Z]/{i=($0 ~ /^(NAME|DESCRIPTION)/); next} i' | awk 'BEGIN{RS=\"\"} {gsub(/\\n/,\" \"); print}' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/man; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-mw-coll grounded "K=$(cat /home/neuron/.config/merriam-webster/mw_collegiate.key 2>/dev/null); [ ${#K} -gt 0 ] && curl -s -m 15 https://www.dictionaryapi.com/api/v3/references/collegiate/json/$(jq -rn --arg w %s '$w|@uri')?key=$K | jq -r '.[]? | objects | .shortdef[]?' 2>/dev/null | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/mw-coll; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-openstax grounded "curl -s -m 15 'https://openstax.org/apps/cms/api/v2/pages/?type=books.Book&fields=title&limit=200' | jq -r '.items[].title' 2>/dev/null | grep -iw -- %s | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/openstax; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-wiktionary ungrounded "curl -s -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' https://en.wiktionary.org/api/rest_v1/page/definition/$(jq -rn --arg w %s '$w|@uri') | jq -r '.en[]? | select(.language|ascii_downcase|startswith(\"english\")) | .definitions[]? | .definition' 2>/dev/null | sed 's/<[^>]*>//g' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/wiktionary; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-wikipedia ungrounded "curl -s -L -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' https://en.wikipedia.org/api/rest_v1/page/summary/$(jq -rn --arg w %s '$w|@uri') | jq -r '.extract // empty' 2>/dev/null | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/wikipedia; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-wikidata ungrounded "curl -s -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' 'https://www.wikidata.org/w/api.php?action=wbsearchentities&language=en&format=json&limit=1&search='$(jq -rn --arg w %s '$w|@uri') | jq -r '.search[0].description // empty' 2>/dev/null | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/wikidata; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-oeis grounded "curl -s -m 15 'https://oeis.org/search?fmt=json&q='$(jq -rn --arg w %s '$w|@uri') | jq -r '(if type==\"array\" then . else (.results // []) end)[]? | .name' 2>/dev/null | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z0-9.]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/oeis; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-codata grounded "curl -s -m 20 https://physics.nist.gov/cuu/Constants/Table/allascii.txt | grep -i -m1 -w -- %s | tr -s ' ' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z0-9.]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/codata; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-godoc grounded "go doc %s 2>/dev/null | awk 'BEGIN{RS=\"\"} {gsub(/\\n/,\" \"); print}' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/godoc; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-vera grounded "exec 2>/dev/null; curl -s -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' \"dict://dict.org/d:$(jq -rn --arg w %s '$w|@uri'):vera\" | tr -d '\\r' | awk '/^151 /{i=1;e=\"\";next} i&&/^\\.$/{print e;i=0;next} i{e=e\" \"$0}' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/vera; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-fd-eng-fra grounded "exec 2>/dev/null; curl -s -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' \"dict://dict.org/d:$(jq -rn --arg w %s '$w|@uri'):fd-eng-fra\" | tr -d '\\r' | awk '/^151 /{i=1;e=\"\";next} i&&/^\\.$/{print e;i=0;next} i{e=e\" \"$0}' | LC_ALL=C.UTF-8 sed 's/[^[:alpha:]]\\{1,\\}/ /g;s/^ *//;s/ *$//' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/fd-eng-fra; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-roget grounded "exec 2>/dev/null; curl -s -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' https://www.gutenberg.org/cache/epub/10681/pg10681.txt | tr -d '\\r' | tr '\\n' ' ' | sed 's/ \\(N\\|V\\|Adj\\|Adv\\|Phr\\|Int\\)\\. /;/g;s/\\. \\{2,\\}/;/g;s/&c//g;s/\\[[^]]*\\]//g' | tr ';' '\\n' | grep -iwF -- %s | LC_ALL=C sed 's/([^)]*)//g;s/[^A-Za-z,]\\{1,\\}/ /g;s/ *, */, /g;s/^[ ,]*//;s/[ ,]*$//' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/roget; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-sep grounded "exec 2>/dev/null; curl -s -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' -f \"https://plato.stanford.edu/entries/$(jq -rn --arg w %s '$w|ascii_downcase|gsub(\" \";\"-\")|@uri')/\" | tr -d '\\r' | sed -n '/<div id=\"preamble\">/,/<\\/div>/p' | tr '\\n' ' ' | sed 's/<[^>]*>/ /g;s/&[a-zA-Z0-9#]*;/ /g' | awk 'NF' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/sep; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
source src-eb1911 grounded "exec 2>/dev/null; curl -s -m 15 -A 'neuron-hp2/1 (a learning program; one lookup at a time)' \"https://en.wikisource.org/w/api.php?action=query&list=search&srlimit=10&format=json&srsearch=$(jq -rn --arg w %s '$w+\" prefix:1911 Encyclopædia Britannica/\"|@uri')\" | jq -r '.query.search[]? | (.title|sub(\"^1911 Encyclop[^/]*/\";\"\")) + \" \" + (.snippet|gsub(\"<[^>]*>\";\"\")|gsub(\"&[a-z#0-9]+;\";\" \")|gsub(\"\\\\n\";\" \"))' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | awk 'NF>60{gsub(/[.;] /,\"&\\n\")} 1' | LC_ALL=C sed 's/[^A-Za-z]\\{1,\\}/ /g;s/^ *//;s/ *$//' | { d=spec/eb1911; mkdir -p $d; f=$d/$(echo %s | tr -c A-Za-z0-9 _); awk NF > $f; [ -s $f ] && echo $f; }"
