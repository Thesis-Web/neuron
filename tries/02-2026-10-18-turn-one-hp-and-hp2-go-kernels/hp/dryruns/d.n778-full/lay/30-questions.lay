# 30-questions.lay (Builder C; know-this extended by the lead for turn two): the born questions as triggers, balance, belief, guessing, the ladder,
# "what is this?", the newborn, and compiling the answer. Fills: newborn ask-what-is compile balance believe guess answer.
# Every test is the first gate of its own small proc so its arrival is unique; every outcome a test can give has a branch.
# A question run starts with its subject gate g on the pad. Told values are visible as =n tokens.

# ---------- guards every question shares
# q-deep: ends a question run deeper than the told depth (storm guard); otherwise drops the difference and goes on
proc q-deep: q-deep-args q-deep-test
# q-deep-args: puts this run's depth and the told limit on the pad
proc q-deep-args: read-depth =3
# q-deep-test: compares depth with the limit; deeper ends, else the difference is dropped
proc q-deep-test: compare
  more -> end
  same -> drop
  less -> drop
# q-none: the question did not apply or found nothing: lowers its trigger's worth a little and ends (writes nothing)
proc q-none: q-none-trig
# q-none-trig: finds the trigger that started this run; a run with no trigger just ends
proc q-none-trig: read-mytrig
  found -> q-lower
  none -> end
# q-lower: [gate proc] re-weighs the trigger at this run's worth minus a told step, then ends
proc q-lower: read-worth =0.05 sub write-trig end
# q-land: [.. x] lands x on the parent's pad (a copy stays as this run's outcome) and raises the trigger that asked
proc q-land: dup land q-land-trig
# q-land-trig: finds the trigger that started this run; no trigger means nothing to raise
proc q-land-trig: read-mytrig
  found -> q-raise
  none -> drop
# q-raise: [gate proc] re-weighs the trigger at this run's worth plus a told step, capped at the told ceiling
proc q-raise: q-raise-args q-raise-cap write-trig
# q-raise-args: new worth = worth + 0.1, then a copy and the ceiling for the cap test
proc q-raise-args: read-worth =0.1 add dup =0.8
# q-raise-cap: above the ceiling takes the ceiling, else keeps the sum
proc q-raise-cap: compare
  more -> q-cap8
  same -> drop
  less -> drop
# q-cap8: [.. w d] replaces the sum with the ceiling
proc q-cap8: drop drop =0.8

# ---------- Do I know this? (fires on arriving at a meaning gate; looks at the definition memory)
# know-this: g -- : a word (a labeled gate) with no source text in section 3 is thin -> a gap row and a source check
proc know-this: q-deep dup know-word know-s3 know-empty know-thin
# know-word: a gate with a label is a word someone can say, whatever its binding: its definition is checked;
# a gate with no label (physics, outcome, kind, a told process) is machinery and is known: the question ends
proc know-word: read-label
  found -> drop
  none -> q-none
# know-s3: [g] -> [g n3] counts section 3 (source texts) of g
proc know-s3: dup =3 know-def
# know-def: reads one definition section; found or not, the count is what matters next
proc know-def: read-def
  found -> read-count
  none -> read-count
# know-empty: [g n3] -> [g n3 0] the told mark: no source text at all is thin (relationships alone do not define a word)
proc know-empty: =0
# know-thin: an empty section 3 is thin -> gap; a held source text -> has the word a meaning yet? (turn two)
proc know-thin: compare
  same -> know-gap
  more -> know-act
  less -> know-act
# know-act: [g d] -> [g t x] / [g]: a binding is a meaning (read-bind found); none means a spec with no meaning yet
proc know-act: drop dup know-bind
proc know-bind: read-bind
  found -> know-known
  none -> know-compile
# know-known: [g t x] -> the word has its meaning: the question does not apply
proc know-known: drop drop q-none
# know-compile: [g] -> a word with a spec and no action is a gap of the meaning kind: the gap row for the sixth, and the
# meaning way now (45-meaning.lay) when the question is about the person's own input (depth at or under check-depth)
proc know-compile: dup 'gap swap dup dup dup write-row drop read-depth check-depth know-compile-near
proc know-compile-near: compare
  more -> drop
  same -> know-meaning
  less -> know-meaning
# know-meaning: [g d] -> splits the meaning way on g
proc know-meaning: drop 'meaning swap split
# know-gap: [g d] -> always writes (or finds) the gap row keyed by g; then asks a source only when the question is about
# the person's own input (depth at or under check-depth); deeper gaps are left for the sixth, one per spare beat
proc know-gap: drop dup 'gap swap dup dup dup write-row drop read-depth check-depth know-near
# check-depth: the told depth under which a gap checks sources at once; the brain can change it with write-value
gate check-depth = 1
# know-near: [g depth told] -> deeper than told means the gap row is enough; else a source check splits off on g
proc know-near: compare
  more -> drop
  same -> know-source
  less -> know-source
# know-source: [g d] -> [] splits source-check on g (What does a source say?)
proc know-source: drop 'source-check swap split

# ---------- Have I done this before? Was I right? Was I wrong a lot? (blueprint 8: at the end of each phrase, and at = and ?)
# done-before: g -- : finds the memory of the run that asked, lands what it said before; wrong a lot -> an imbalance row
proc done-before: q-deep done-parent
# done-parent: the memory id of the run that asked (none: this is not a question run)
proc done-parent: read-parent
  found -> done-mem
  none -> q-none
# done-mem: the memory's counts; none means this input was never finished before
proc done-mem: read-mem
  found -> done-right
  none -> q-none
# done-right: [g out seen right wrong last] -> drops last, puts the told "a lot" beside wrong
proc done-right: drop =2 done-wrong-test
# done-wrong-test: wrong above the told count is "wrong a lot"
proc done-wrong-test: compare
  more -> wrong-a-lot
  same -> done-land
  less -> done-land
# done-land: [g out seen right d] -> [g out] the outcome text of the old run (the gate it said)
proc done-land: drop drop drop done-label
# done-label: the said gate, if it is a labeled gate: land it (a hop to memory instead of the long way)
proc done-label: find-label
  found -> q-land
  none -> q-none
# wrong-a-lot: [g out seen right d] -> writes an imbalance row keyed by g (What did I try when I was wrong? is the sixth's return to it) and ends
proc wrong-a-lot: drop drop drop drop dup 'imbalance swap dup dup dup write-row drop q-none

# ---------- Was the environment different? (at = ? . !) compares the old memory's time with now
# env-diff: g -- : an old memory older than the told span -> a questions row keyed by g for the sixth
proc env-diff: q-deep env-parent
# env-parent: the memory id of the run that asked
proc env-parent: read-parent
  found -> env-mem
  none -> q-none
# env-mem: the memory's counts, last time on top
proc env-mem: read-mem
  found -> env-age
  none -> q-none
# env-age: [g out seen right wrong last] -> [g out seen right wrong age told] age = now - last
proc env-age: clock swap sub =86400000 env-old
# env-old: older than the told span means the environment may have changed
proc env-old: compare
  more -> env-row
  same -> q-none
  less -> q-none
# env-row: [g out seen right wrong d] -> writes the question row keyed by g (the sixth returns to it)
proc env-row: drop drop drop drop drop dup 'questions swap dup dup dup write-row drop

# ---------- Am I stuck? (a trigger: read-steps in a question run gives the root run's steps; also a step inside the ladder)
# stuck: g -- g : past the told step count writes a slow row keyed by g and ends; else goes on with g
proc stuck: read-steps =400 stuck-test
# stuck-test: steps above the told count means stuck
proc stuck-test: compare
  more -> stuck-row
  same -> drop
  less -> drop
# stuck-row: [g d] -> a slow row keyed by g, then the run ends (writes nothing more)
proc stuck-row: drop dup 'slow swap dup dup dup write-row drop end

# ---------- Is this shaped like something I've done? (a trigger: a question run inherits the asking run's shape)
# shaped-like: g -- : runs of the same shape (not this one) -> lands the memories, then what the newest of them said
proc shaped-like: q-deep read-shape shape-find
# shape-find: memories with this shape
proc shape-find: find-shape
  found -> shape-land
  none -> q-none
# shape-land: [g l] -> lands the memory list (a copy stays), then takes the newest memory's row
proc shape-land: dup land dup read-count =1 sub shape-item
proc shape-item: read-item
  found -> shape-row
  none -> q-none
proc shape-row: read-row
  found -> shape-said
  none -> q-none
# shape-said: [g l sig home body out] -> the gate that run said, if it is a labeled gate: landed (reasoning by shape)
proc shape-said: shape-label
proc shape-label: find-label
  found -> q-land
  none -> q-none

# ---------- balance (11.1): got want -- got ; same is balanced, off writes an imbalance row keyed by got
proc balance: compare
  same -> bal-same
  more -> bal-off
  less -> bal-off
# bal-same: [got want d] -> [got] balanced: nothing to record
proc bal-same: drop drop
# bal-off: [got want d] -> [got] off balance: an imbalance row keyed by got (the sixth picks it up)
proc bal-off: drop drop dup 'imbalance swap dup dup dup write-row drop

# ---------- believe (10.3): from type to strength state -- : a new claim meets the held line
# believe: packs the claim as a list [from type to strength state] kept at the pad bottom; weighs, then adopts or keeps
proc believe: =5 read-list dup =2 bel-to
# bel-to: [l l 2] -> [l to] the claim's target gate
proc bel-to: read-item
  found -> bel-use
  none -> end
# bel-use: memory support: the memories the target was used in (the list is pushed found or not)
proc bel-use: read-use
  found -> bel-count
  none -> bel-count
# bel-count: [l l-use] -> [l sup] support = count x told weight, then the claim's own strength beside it
proc bel-count: read-count =0.1 mul over =3 bel-snew
# bel-snew: [l sup l 3] -> [l sup s-new]
proc bel-snew: read-item
  found -> bel-sum
  none -> end
# bel-sum: [l sup s-new] -> [l s-w] the weighed new strength; then the triple for the held line
proc bel-sum: add over dup =0 bel-i0
# bel-i0: [l s-w l l 0] -> [l s-w l from]
proc bel-i0: read-item
  found -> bel-t1
  none -> end
# bel-t1: [l s-w l from] -> [l s-w from l 1]
proc bel-t1: swap dup =1 bel-i1
proc bel-i1: read-item
  found -> bel-t2
  none -> end
# bel-t2: [l s-w from l type] -> [l s-w from type l 2]
proc bel-t2: swap dup =2 bel-i2
proc bel-i2: read-item
  found -> bel-t3
  none -> end
# bel-t3: [l s-w from type l to] -> [l s-w from type to] -> the held line
proc bel-t3: swap drop bel-held
# bel-held: the held line's strength and state; nothing held means the claim is adopted
proc bel-held: read-strength
  found -> bel-ineq-args
  none -> bel-adopt
# bel-ineq-args: [l s-w s-held st] -> [l s-w s-held]
proc bel-ineq-args: drop bel-ineq
# bel-ineq: the inequality: the weighed new strength against the held one; closer (more) adopts
proc bel-ineq: compare
  more -> bel-adopt
  same -> bel-keep
  less -> bel-keep
# bel-adopt: [l x] -> [l] -> re-expands the claim and writes it as the held line
proc bel-adopt: drop bel-expand
# bel-expand: [l] -> [from type to strength state] then write-rel; says why in gates: because believe yes
proc bel-expand: dup =0 bel-x0
proc bel-x0: read-item
  found -> bel-x1
  none -> end
# bel-x1: [l from] -> [from l type]
proc bel-x1: swap dup =1 bel-x1i
proc bel-x1i: read-item
  found -> bel-x2
  none -> end
# bel-x2: [from l type] -> [from type l to]
proc bel-x2: swap dup =2 bel-x2i
proc bel-x2i: read-item
  found -> bel-x3
  none -> end
# bel-x3: [from type l to] -> [from type to l strength]
proc bel-x3: swap dup =3 bel-x3i
proc bel-x3i: read-item
  found -> bel-x4
  none -> end
# bel-x4: [from type to l strength] -> [from type to strength l state]
proc bel-x4: swap dup =4 bel-x4i
proc bel-x4i: read-item
  found -> bel-write
  none -> end
# bel-write: [from type to strength l state] -> drops the list, writes the relationship, says why in gates
proc bel-write: swap drop write-rel read-mark 'w-because 'believe 'yes say-word
# bel-keep: [l d] -> keeps the held line and says why in gates: because believe no
proc bel-keep: drop drop read-mark 'w-because 'believe 'no say-word

# ---------- guess (10.6): g -- : only after the ladder; reaches along r-like then r-kind-of for a likely next gate
# guess: [g] -> [g guesses g] then the reach; a guess is landed with state-guess, rowed for the sixth, said with w-maybe
proc guess: 'guesses over dup guess-like
# guess-like: reach along r-like from g (stored line first, then the formula)
proc guess-like: r-like
  found -> guess-pick
  none -> guess-kind
# guess-kind: [g guesses g] -> reach along r-kind-of
proc guess-kind: over r-kind-of
  found -> guess-pick
  none -> guess-none
# guess-none: [g guesses g] -> [g] nothing to guess from
proc guess-none: drop drop
# guess-pick: [g guesses g l] -> the first candidate
proc guess-pick: =0 guess-item
proc guess-item: read-item
  found -> guess-take
  none -> guess-none
# guess-take: [g guesses g x] -> says "maybe x", lands x (state-guess beside it), writes the guesses row keyed by x
proc guess-take: dup read-mark swap 'w-maybe swap say-word 'state-guess land dup land dup dup write-row drop

# ---------- answer (10.4 the ladder): g -- : memory, knowns, history, sources, guess, then "i not know g"
# answer: each rung is its own test-first proc; the first found is landed and the rest of the ladder is not run
proc answer: q-deep rung-mem
# rung-mem: memories g was used in
proc rung-mem: dup rung-use
proc rung-use: read-use
  found -> rung-mem-last
  none -> rung-know
# rung-mem-last: [g l] -> the last memory in the list
proc rung-mem-last: dup read-count =1 sub rung-item
proc rung-item: read-item
  found -> rung-mem-read
  none -> rung-know
# rung-mem-read: [g n] -> the memory's counts (a reserved, unwritten memory gives none)
proc rung-mem-read: read-mem
  found -> rung-mem-out
  none -> rung-know
# rung-mem-out: [g out seen right wrong last] -> [g out] -> the gate said then
proc rung-mem-out: drop drop drop drop rung-mem-label
proc rung-mem-label: find-label
  found -> q-land
  none -> rung-know
# rung-know: [g] -> stuck check, then what it knows: g's relationships
proc rung-know: stuck dup rung-rels
proc rung-rels: read-rels
  found -> rung-know-first
  none -> rung-hist
# rung-know-first: [g l] -> the first relationship line [type other strength state]
proc rung-know-first: =0 rung-know-item
proc rung-know-item: read-item
  found -> rung-know-other
  none -> rung-hist
# rung-know-other: [g line] -> the other gate of the line
proc rung-know-other: =1 rung-know-item2
proc rung-know-item2: read-item
  found -> q-land
  none -> rung-hist
# rung-hist: [g] -> state and history: memories in the told span before now
proc rung-hist: stuck clock dup =3600000 sub swap rung-time
proc rung-time: find-time
  found -> rung-hist-first
  none -> rung-src
# rung-hist-first: [g l] -> the newest memory in the span -> its row -> its home gate
proc rung-hist-first: dup read-count =1 sub rung-hist-item
proc rung-hist-item: read-item
  found -> rung-hist-row
  none -> rung-src
proc rung-hist-row: read-row
  found -> rung-hist-home
  none -> rung-src
# rung-hist-home: [g sig home body out] -> [g home] then: about the subject? (the home gate is the subject gate)
proc rung-hist-home: drop drop swap drop over over rung-hist-about
# rung-hist-about: distance between home and g: same means the memory is about the subject
proc rung-hist-about: compare
  same -> rung-hist-mine
  more -> rung-hist-other
  less -> rung-hist-other
# rung-hist-mine: [g home d] -> [g home] lands the home gate (history about this subject)
proc rung-hist-mine: drop q-land
# rung-hist-other: [g home d] -> [g] history about something else: on to the sources
proc rung-hist-other: drop drop rung-src
# rung-src: [g] -> asks the sources (source-check runs as a branch) and waits for what lands, then guesses if nothing did
proc rung-src: stuck dup 'source-check swap split wait read-pad =1 rung-src-test
# rung-src-test: more than g on the pad means a source landed something
proc rung-src-test: compare
  more -> rung-src-landed
  same -> rung-guess
  less -> rung-guess
# rung-src-landed: [g x d] -> [g x] -> lands what the source gave
proc rung-src-landed: drop q-land
# rung-guess: [g d] -> [g] -> the labeled guess, then the test whether it gave anything
proc rung-guess: drop guess read-pad =1 rung-guess-test
proc rung-guess-test: compare
  more -> drop
  same -> rung-dunno
  less -> rung-dunno
# rung-dunno: [g d] -> says "i not know g" through say-word (a mark, the items, say-word) and ends
proc rung-dunno: drop read-mark swap 'w-i swap 'w-not swap 'w-know swap say-word q-none

# ---------- ask-what-is: g -- : "what is this?": memory first, then ask back in gates, and park the question
proc ask-what-is: dup ask-use
# ask-use: memories g was used in: seen before means it was placed once, nothing to ask
proc ask-use: read-use
  found -> ask-known
  none -> ask-say
# ask-known: [g l] -> [] it has been in runs before
proc ask-known: drop drop
# ask-say: [g l] -> drops the empty use list, writes the questions row keyed by g (same key, same row), then asks back only the first time
proc ask-say: drop dup 'questions swap dup dup dup write-row ask-seen
# ask-seen: the row's counts: seen once means the question is new
proc ask-seen: read-mem
  found -> ask-once
  none -> drop
# ask-once: [g out seen right wrong last] -> [g seen 1]
proc ask-once: drop drop drop swap drop =1 ask-first
# ask-first: a new question is asked back; one already parked stays silent (the sixth returns to it)
proc ask-first: compare
  same -> ask-voice
  more -> ask-quiet
  less -> ask-quiet
# ask-voice: [g d] -> asks the person only when the question is about their own input (depth at or under check-depth);
# a word met deeper (inside a reading run) keeps its questions row for the sixth and stays silent
proc ask-voice: drop read-depth check-depth ask-near
proc ask-near: compare
  more -> drop
  same -> ask-speak
  less -> ask-speak
# ask-speak: [g d] -> says "g what ?" through say-word (a mark, the items, say-word)
proc ask-speak: drop read-mark swap 'w-what 'key-qmark say-word
# ask-quiet: [g d] -> [] nothing said
proc ask-quiet: drop drop

# ---------- newborn: g -- g : gives a spawned gate its born questions (blueprint 8: know-this, what is this, answer, stuck;
# done-before and shaped-like fire at the phrase keys, not on every gate) and, when it arrived with nothing, a gap row
proc newborn: dup 'know-this =0.5 write-trig dup 'ask-what-is =0.6 write-trig dup 'answer =0.4 write-trig dup 'stuck =0.3 write-trig dup =5 is-new
# is-new: section 5 of the new gate: relationships it arrived with mean it is placed; none means a gap
proc is-new: read-def
  found -> drop
  none -> newborn-root
# newborn-root: [g l] -> a word someone gave the brain (a root run) with nothing is a gap; a word met inside a
# reading run (a question run) is placed by its line to the headword and is no gap until an input uses it
proc newborn-root: read-parent
  found -> newborn-child
  none -> newborn-gap
proc newborn-child: drop drop
# newborn-gap: [g l] -> [g] writes the gap row keyed by g
proc newborn-gap: drop dup 'gap swap dup dup dup write-row drop

# ---------- compile: (pad) -- outcome : the scratch pad becomes the answer (entered by end-of-run after wait)
proc compile: compile-parent
# compile-parent: a question run says nothing: its outcome is what it landed (the pad top)
proc compile-parent: read-parent
  found -> compile-child
  none -> compile-main
# compile-child: [x m L.. p] -> [L] the newest landing, or [x] the run's own outcome when nothing landed
proc compile-child: drop read-tomark dup read-count =0 compile-child-test
proc compile-child-test: compare
  more -> compile-last
  same -> compile-none
  less -> compile-none
# compile-last: [x l d] -> [L] the last landing
proc compile-last: drop dup read-count =1 sub read-item swap drop
# compile-none: [x l d] -> [x]
proc compile-none: drop drop
# compile-main: [x m L..] -> [x l] then: a want balances x against it; else the outcome and the landings are said
proc compile-main: read-tomark compile-want
proc compile-want: read-want
  found -> compile-balance
  none -> compile-count
# compile-balance: [x l want] -> [x want] -> balance -> [got] -> says got
proc compile-balance: swap drop balance compile-say-top
# compile-say-top: [.. x] -> [.. x x] says the balanced item x through say-word (which leaves the first said item); end-said drops the copy
proc compile-say-top: dup read-mark swap say-word
# compile-count: [x l] -> [x m P]: the landings then the outcome as one list, walked from its end (the outcome is said
# first, then the landings, newest first) under a pair P=[l last]; x stays under the mark as the outcome
proc compile-count: over add dup read-count =1 sub =2 read-list read-mark swap cs-loop
# cs-loop: [m kept.. P] -> takes the list and the index out of P, then the i-th item
proc cs-loop: dup =0 cs-l
proc cs-l: read-item
  found -> cs-i
  none -> drop
# cs-i: [.. P l] -> [.. P l i]
proc cs-i: over =1 cs-ii
proc cs-ii: read-item
  found -> cs-x
  none -> drop
# cs-x: [.. P l i] -> [.. P x]; before the start of the list -> done
proc cs-x: read-item
  found -> cs-keep
  none -> cs-done
# cs-keep: a meaning is a labeled gate, or an unlabeled plain or value gate (said as its address #n);
# machinery bindings (physics, outcome, kind, tier, state, fid, port, PROC), numbers, texts, lists and marks are not said
proc cs-keep: dup cs-label
proc cs-label: read-label
  found -> cs-take
  none -> cs-isgate
# cs-take: [.. P x t] -> [.. x P] the meaning goes above the mark, under P
proc cs-take: drop swap cs-next
# cs-isgate: [.. P x] -> find-label on a gate finds it; a number, text, list or mark is popped and not said
proc cs-isgate: dup cs-gate
proc cs-gate: find-label
  found -> cs-bindq
  none -> cs-skip
# cs-bindq: [.. P x x] -> [.. P x] then the binding test
proc cs-bindq: drop dup cs-bind
proc cs-bind: read-bind
  none -> cs-plain
  found -> cs-bound
# cs-plain: [.. P x] -> [.. x P] an unlabeled plain gate is a meaning in hand
proc cs-plain: swap cs-next
# cs-bound: [.. P x t v] -> [.. P x] then: a value gate is a meaning (a number the brain made a gate for)
proc cs-bound: drop drop dup cs-value
proc cs-value: read-value
  found -> cs-valgate
  none -> cs-skip
# cs-valgate: [.. P x n] -> [.. x P]
proc cs-valgate: drop swap cs-next
# cs-skip: [.. P x] -> [.. P] machinery is not said
proc cs-skip: drop cs-next
# cs-next: [.. P] -> [.. P l i] -> i-1 -> P' = [l i-1] -> loop
proc cs-next: dup =0 cs-nl
proc cs-nl: read-item
  found -> cs-ni
  none -> drop
proc cs-ni: over =1 cs-nii
proc cs-nii: read-item
  found -> cs-inc
  none -> drop
proc cs-inc: =1 sub =2 read-list swap drop cs-loop
# cs-done: [g m kept.. P] -> [g l] the said list (the meanings above the mark); nothing to say stays silent
proc cs-done: drop read-tomark dup read-count =0 cs-any
proc cs-any: compare
  more -> cs-say
  same -> drop
  less -> drop
# cs-say: [g l d] -> [g l] says l through say-word (which leaves the first said item, l itself); end-said drops it, g is the outcome
proc cs-say: drop read-mark swap say-word

# ---------- where the questions fire: the prime gates, numbers and operators (A's names), and the phrase ends
trig key-qmark -> answer 0.7
trig key-qmark -> shaped-like 0.5
trig key-qmark -> done-before 0.7
trig key-qmark -> env-diff 0.3
trig equals -> answer 0.7
trig equals -> done-before 0.7
trig equals -> env-diff 0.3
trig key-dot -> done-before 0.6
trig key-dot -> env-diff 0.3
trig key-bang -> done-before 0.6
trig w-i -> know-this 0.5
trig w-i -> stuck 0.3
