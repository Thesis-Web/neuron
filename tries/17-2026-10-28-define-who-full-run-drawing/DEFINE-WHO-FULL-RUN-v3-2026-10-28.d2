# define : who  -  the whole run from a fresh brain, drawn 2026-10-28 (v3, after the owner's second correction)
# Every neuron is its own table. Numbers only in the tables. The words are in the tool pins (hover the i).
# [his: date] = the owner's words. [reading] = mine, to strike. [open] = his call.
direction: down
grid-rows: 1
grid-gap: 90
vars: { d2-config: { layout-engine: elk } }
classes: {
  column: {style.fill: "#ffffff"; style.stroke: "#ffffff"; style.stroke-width: 0}
  lane: {style.fill: "#f8fafc"; style.stroke: "#334155"; style.stroke-width: 2; style.border-radius: 8; style.font-size: 26}
  col: {style.fill: "#ffffff"; style.stroke: "#94a3b8"; style.stroke-width: 1; style.border-radius: 6}
  neuron: {shape: sql_table; style.fill: "#93c5fd"; style.stroke: "#eff6ff"; style.stroke-width: 2}
  hit: {shape: sql_table; style.fill: "#bfdbfe"; style.stroke: "#f8fbff"; style.stroke-width: 1}
  newborn: {shape: sql_table; style.fill: "#f9a8d4"; style.stroke: "#fdf2f8"; style.stroke-width: 2}
  built: {shape: sql_table; style.fill: "#fdba74"; style.stroke: "#fff7ed"; style.stroke-width: 2}
  defn: {shape: sql_table; style.fill: "#fde047"; style.stroke: "#fefce8"; style.stroke-width: 2}
  mem: {shape: sql_table; style.fill: "#86efac"; style.stroke: "#f0fdf4"; style.stroke-width: 2}
  sheet: {shape: sql_table; style.fill: "#6ee7b7"; style.stroke: "#ecfdf5"; style.stroke-width: 1}
  tl: {shape: sql_table; style.fill: "#c4b5fd"; style.stroke: "#f5f3ff"; style.stroke-width: 2}
  encoder: {shape: sql_table; style.fill: "#cbd5e1"; style.stroke: "#f8fafc"; style.stroke-width: 2}
  key: {shape: sql_table; style.fill: "#fca5a5"; style.stroke: "#fef2f2"; style.stroke-width: 1}
  sixth: {shape: sql_table; style.fill: "#d8b4fe"; style.stroke: "#faf5ff"; style.stroke-width: 2}
  guess: {shape: sql_table; style.fill: "#f0abfc"; style.stroke: "#fdf4ff"; style.stroke-width: 2}
  mail: {shape: queue; style.fill: "#e0f2fe"; style.stroke: "#0369a1"}
  mother: {shape: hexagon; style.fill: "#fee2e2"; style.stroke: "#991b1b"; style.stroke-width: 2}
  prompt: {shape: document; style.fill: "#fee2e2"; style.stroke: "#991b1b"}
  src: {shape: package; style.fill: "#ffedd5"; style.stroke: "#c2410c"}
  brain: {shape: package; style.fill: "#ede9fe"; style.stroke: "#7c3aed"; style.stroke-width: 2}
  pick: {shape: diamond; style.fill: "#f1f5f9"; style.stroke: "#334155"}
  note: {style.fill: "#fffbeb"; style.stroke: "#d4a72c"; style.font-size: 14}
  his: {style.fill: "#fef3c7"; style.stroke: "#b45309"; style.font-size: 14}
  open: {style.fill: "#ffe4e6"; style.stroke: "#be123c"; style.font-size: 14}
  closed: {style.fill: "#dcfce7"; style.stroke: "#15803d"; style.font-size: 14}
  hop: {style.stroke: "#1d4ed8"; style.stroke-width: 3}
  trig: {style.stroke: "#ea580c"; style.stroke-dash: 5; style.stroke-width: 2}
  call: {style.stroke: "#15803d"; style.stroke-dash: 2; style.stroke-width: 2}
  spawn: {style.stroke: "#7c3aed"; style.stroke-dash: 8; style.stroke-width: 2}
  jump: {style.stroke: "#0f172a"; style.stroke-width: 4}
  route: {style.stroke: "#991b1b"; style.stroke-width: 3}
  fill: {style.stroke: "#059669"; style.stroke-dash: 2; style.stroke-width: 2}
  readw: {style.stroke: "#64748b"; style.stroke-dash: 1; style.stroke-width: 1}
  back: {style.stroke: "#b45309"; style.stroke-dash: 6; style.stroke-width: 3}
  builtw: {style.stroke: "#c2410c"; style.stroke-dash: 1; style.stroke-width: 2}
  not: {style.stroke: "#94a3b8"; style.stroke-dash: 3; style.stroke-width: 1; style.opacity: 0.6}
}
A: "" {
  class: column; grid-columns: 1; grid-gap: 70
  key: "KEY, and the inside of every step" {
    class: lane; grid-columns: 5; grid-gap: 24
    title: "define : who, the whole run from a fresh brain. v3, 2026-10-28, after his two corrections of the day. Read down each column; A the main flow, B the born runs and the formula, C outside and the other brains." {class: his; tooltip: "Every box carries his words in its tool pin, with the date. Numbers in the tables are this drawing's numbering: gates in the order laid, shards one sequence."}
    k_neuron: "NEURON = its own table (64 · define)" {class: neuron; shard: "before > trigger | call | spawn"; tooltip: "A neuron is its own table; its name is its gate (10-19 21:14). Rows are its DNA: his sketch 10-28 gives shard id | before | trigger | call | spawn. The run arrives from before, goes on to trigger, calls side runs that return, spawns runs that leave."}
    k_hit: "one HIT of a gate (the neuron drawn where it is hit)" {class: hit; shard: "before > next"; tooltip: "In a run column every box is one hit of a gate, drawn where the run hits it (his sketch). The row shown is the shard this run hit or wrote."}
    k_newborn: "NEWBORN on this line" {class: newborn; shard: "..."; tooltip: "A gate that did not exist when the line arrived: born by the born run (10-20 01:22; 10-19 23:40)."}
    k_built: "BUILT by the brain in this run (a formula neuron)" {class: built; shard: "..."; tooltip: "His words 10-28: the three standing questions are large processes the brain builds itself from the hand-laid meanings; a long run that worked gets a new neuron born for its formula, relationally matched to the long run, usable with other variables. No spelling in the encoder: the label here is for the reader."}
    k_defn: "DEFINITION NODE (born with the neuron; its first memory)" {class: defn; source: "> return run"; rel: "kind > gate"; tooltip: "10-19 23:40; 10-23 P2; 10-23 P5-9: relationships are built from the definition table."}
    k_mem: "MEMORY NODE on the shard that ended a run (the run data sheet inside)" {class: mem; run: "input, source"; cell: "state, value"; tooltip: "10-23 P2 B2; 10-26 03:50; his v4 brain.db 10-27: run_memory + run_sheet. A neuron with several ending shards has several memory nodes (his words 10-28)."}
    k_tl: "TIMELINE: only a memory table" {class: tl; at: "receipt > memory node, key words"; tooltip: "10-16 06:40; 10-26 03:50."}
    k_key: "THE KEY: what travels with anything that leaves and comes back" {class: key; run_cell: "who, when, why, modifiers"; tooltip: "His words 10-28: an sql trigger cannot just leave the brain; it is part of a process that says to the mother, the mother routes the script to the sources or the sql prompt and routes the response back through the encoder as secondary input so the brain can use the data to solve a run already in progress. The key is the metadata: what is this data in perspective to this run, where does it belong, what does it solve, who said it, when, why is it needed, what modifiers does it change. His guesses, by his word."}
    k_sixth: "THE SIXTH: its own brain, its own runs" {class: sixth; asks: "why that way? better way? correct shard? balance?"; tooltip: "His words 10-28: the inner voice that observes or oversees all the runs and asks questions."}
    k_guess: "THE GUESSING BRAIN: a hand-built llm over a small corpus" {class: guess; guess: "confidence, belief, times used, times solved"; tooltip: "His words 10-28: qkv, weights, corpus, hidden layers, back propagation, context; learns on the fly; every answer labeled a guess with a confidence; belief never over 50% on first use."}
    wires: "WIRES" {
      class: col; grid-columns: 5; grid-gap: 10
      w1: "hop" {style.stroke: "#1d4ed8"; style.stroke-width: 3; tooltip: "The run moves to the remainder head; before and after; the key is the remainder (§12 law 13)."}
      w2: "trigger" {style.stroke: "#ea580c"; style.stroke-width: 3; tooltip: "A DNA row excites a run (10-26 05:12); it writes nothing itself (10-26 03:59)."}
      w3: "call (returns)" {style.stroke: "#15803d"; style.stroke-width: 3; tooltip: "A side run whose answer comes back to this run (his sketch)."}
      w4: "spawn (leaves)" {style.stroke: "#7c3aed"; style.stroke-width: 3; tooltip: "A run that goes off on its own (his sketch)."}
      w5: "jump (formula path)" {style.stroke: "#0f172a"; style.stroke-width: 3; tooltip: "Skip the long run: the formula neuron, plug the value in (his words 10-28)."}
      w6: "carried by mother" {style.stroke: "#991b1b"; style.stroke-width: 3; tooltip: "Mother routes and traverses, decides nothing (10-23 P2)."}
      w7: "a return fills a cell" {style.stroke: "#059669"; style.stroke-width: 3; tooltip: "10-26 03:50."}
      w8: "a run reads a table" {style.stroke: "#64748b"; style.stroke-width: 3; tooltip: "Read runs: the standing questions, the inspection, the sixth looking."}
      w9: "step back / eliminate" {style.stroke: "#b45309"; style.stroke-width: 3; tooltip: "His words 10-28: a failed cell sends the run back to a choice; the failed choice is remembered from the timeline and eliminated."}
      w10: "built from (tools compounding)" {style.stroke: "#c2410c"; style.stroke-width: 3; tooltip: "His words 10-28: tool 1 + tool 2 makes tool 3; the brain builds its tools from the hand-laid ones."}
    }
    step: "THE INSIDE OF EVERY STEP (his words 10-28)" {
      class: col; grid-columns: 1; grid-gap: 10
      s1: "what does the brain need to complete this step?" {class: his; tooltip: "His words 10-28: every inside step is 'what does the brain need to complete this'."}
      s2: "with the tools the brain has, how does it build that need?" {class: his; tooltip: "His words 10-28: 'with the tools the brain has how does it build that need'. At first this is recursive: each process is decomposed and built step by step; more tools may be needed, built step by step, then used, then combined."}
      s3: "decide, build, check" {class: his; tooltip: "His words 10-28: 'it's just one step decide, build, check, next step, build, check, add to the previous, next step decide, build, check, add to steps that are relevant, combine in different ways to make other things that work'."}
      s4: "next step; add to the previous; combine" {class: his; tooltip: "His words 10-28: once five of the correct versatile tools exist there is an abundance of possibilities; the hand-laid core is the decomposition of tools down to the most basic."}
      s1 -> s2 -> s3 -> s4
      s4 -> s1: {class: not; label: "recursive at first"}
    }
  }
  core: "0 · THE FRESH BRAIN: the hand-laid tools (his outline 10-25 21:50; v1 10-19; his 14 physical actions 10-23 P2). The count is unknown: 20, 80 or 200 (his words 10-28)" {
    class: lane; grid-columns: 4; grid-gap: 40
    encoder: "ENCODER: a straight conversion table (the only place a spelling lives)" {
      class: encoder
      tooltip: "10-26 03:50: a straight database conversion table with gates in a sequential order, new word new gate #. 10-25: there are no words in the graph. The brain holds the numbers. 1..63 is this drawing's numbering of the core in the order laid; it is a reading of what must be hand laid, not his list: his words 10-28: 'hand laid that tool is not wrong, but was just out of order, and it didn't need to be hand laid, it just needed to be built by the brain at a different time'."
      g1: "heard"
      g2: "said"
      g3: "space"
      g4: "CREATE"
      g5: "TABLE"
      g6: '"'
      g7: "("
      g8: ")"
      g9: ","
      g10: ";"
      g11: "INTEGER"
      g12: "TEXT"
      g13: "shard"
      g14: "before"
      g15: "trigger"
      g16: "call"
      g17: "spawn"
      g18: "value"
      g19: "definition"
      g20: "source"
      g21: "entry"
      g22: "sense"
      g23: "class"
      g24: "text"
      g25: "example"
      g26: "origin"
      g27: "first_use"
      g28: "synonyms"
      g29: "antonyms"
      g30: "times"
      g31: "first_at"
      g32: "last_at"
      g33: "ended_at"
      g34: "INSERT"
      g35: "INTO"
      g36: "VALUES"
      g37: "SELECT"
      g38: "FROM"
      g39: "WHERE"
      g40: "build"
      g41: "born"
      g42: "hop"
      g43: "write"
      g44: "copy"
      g45: "cut"
      g46: "read"
      g47: "clock"
      g48: "memory"
      g49: "timeline"
      g50: "cell"
      g51: "ask"
      g52: "compile"
      g53: "decide"
      g54: "substitute"
      g55: "compare"
      g56: "say"
      g57: "out"
      g58: "find"
      g59: "split"
      g60: "join"
      g61: "move"
      g62: "add"
      g63: "subtract"
    }
    schemas: "the hand-laid shapes" {
      class: col; grid-columns: 1; grid-gap: 14
      schema_mem: "MEMORY TABLE shape (his own hand, ~/neuron/v4/brain.db, 10-27 01:17)" {class: mem; run: "INTEGER PK"; input: "the receipt"; source: "who spoke: user, mother, sixth"; cell: "INTEGER"; state: "0 declared, 1 filled"; value: "what the return put there"; tooltip: "CREATE TABLE run_memory (run INTEGER PRIMARY KEY, input TEXT NOT NULL, source TEXT NOT NULL); CREATE TABLE run_sheet (run REFERENCES run_memory(run), cell INTEGER, state INTEGER DEFAULT 0 CHECK(state IN (0,1)), value TEXT, PRIMARY KEY(run,cell)). His own typing, 10-27 01:17. This answers the question he asked about on 10-28 ('rows pointed to by the memory row? a table per run, or one cell?'): in SQLite 'the sheet lives in a cell in the memory row' could be (a) one column of the memory row holding the whole sheet, (b) rows of a sheet table keyed by the run number, which the memory row points to, or (c) a separate small table per run. His v4 brain.db is (b). The drawing follows it."}
      schema_def: "DEFINITION NODE shape (his own hand, sqlite history)" {class: defn; source: "which source brain answered"; entry: "the headword the source sent"; sense_class: "..."; text: "pointer to the return run (gates)"; synonyms_antonyms: "..."; times_first_last_ended: "truth shift keeps the old row"; rel: "kind > gate (built from the table)"; tooltip: "CREATE TABLE definition (id, neuron, source, entry, sense, class, text, example, origin, first_use, synonyms, antonyms, times, first_at, last_at, ended_at). His own typing. Born with the neuron (10-19 23:40); the first memory (10-23 P2); relationships are built from this table and self-populate (10-23 P5-9; P4)."}
      schema_tl: "TIMELINE shape" {class: tl; id: "INTEGER PK"; at: "the clock neuron (47)"; receipt: "run > memory node"; key_words: "a few gates"; tooltip: "10-16 06:40; 10-26 03:50; 10-23 P3 B1 (by a trigger hop, never a sweep)."}
      schema_key: "THE KEY on the out mailbox and the return (his guesses 10-28)" {class: key; run: "which run asked"; cell: "which cell it fills"; gate: "who said it: the neuron that sent"; when: "clock reading"; why: "what it solves"; modifiers: "what it changes"; tooltip: "His words 10-28: 'the key or some thought the metadata is the what is this data in perspective to this run, where does it belong, what does it solve, who said it, when did it happen, why is it needed. what modifiers does it change... pure guesses by me here'. The out neuron (60) writes it; the secondary input carries it back; the return fills the cell by it. 10-26 05:12: 'the only way we have found that a trigger is needed is with a say key'."}
    }
    outside: "OUTSIDE THE BRAIN" {
      class: col; grid-columns: 2; grid-gap: 14
      m_user_in: "user > encoder" {class: mail; tooltip: "His outline 10-25 21:50. Populated-driven, never a timer (10-22 rev17)."}
      m_mother_in: "mother > encoder (secondary input, with the key)" {class: mail; tooltip: "His outline: the secondary input mailbox to the encoder from the mother. SQL answers and source answers come back this way, with the key, so the brain can use the data to solve a run already in progress (his words 10-28)."}
      m_sixth_in: "sixth.db > encoder (third)" {class: mail; tooltip: "His outline: the third input mailbox to the encoder from the sixth.db."}
      m_out: "brain > mother (60 out, with the key) / brain > user" {class: mail; tooltip: "His outline. The out neuron (60) is the port the run hits to leave; its row carries the key."}
      mother: "MOTHER" {class: mother; tooltip: "10-23 P2: just a router and a traverser. That's it. Takes the output and traverses it to the sources, to another brain, or to its own sql; picks up the outputs and brings them back. Works no data."}
      prompt: "THE NEURON PROMPT (the brain's own sql prompt)" {class: prompt; tooltip: "10-24 msg 36: mother pastes the string in the sql prompt and hits enter, waits for the response, returns it as a secondary input. §2.6 his edit 10-24."}
      src_wn: "WordNet" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json): 1 line for who (the WHO agency), 1 for define."}
      src_gcide: "Webster 1913" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json): 1 line for who, 1 for define."}
      src_mw: "Merriam-Webster" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json): 2 lines for who, 2 for define."}
      src_mwt: "M-W thesaurus" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json): 4 like-lines for define."}
      src_moby: "Moby" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json): 3 like-lines for define."}
      src_map: "his relation map" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json): 1 like-line for define."}
      src_sqldoc: "SQLite docs" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json): the meaning of the code words to the silicon; nothing for : in this slice."}
      sixthdb: "sixth.db (its own brain, lane 11)" {class: brain; tooltip: "10-25 msg 41: create copy brain.db rename to sixth.db... update mother for mailbox to sixth."}
      guessdb: "guessing brain (lane 11b)" {class: brain; tooltip: "His words 10-28: built more like an llm, hand built, over a small corpus."}
    }
    notes: "" {
      class: col; grid-columns: 1; grid-gap: 14
      core_note: "the core's neurons are gates 1..63 (the encoder table, left): the SQL words the born run speaks, the space and the marks, his 14 physical actions (read, write, compare, add, subtract, move, find, split, join, clock, hear, say, call, spawn) and the write, copy, cut runs. Each is its own table with hand-laid DNA rows and a definition node fed from the SQL docs. Later a core word becomes a row in the real word's neuron." {class: his; tooltip: "10-19 21:20: hand lay a table, then hand lay those same words as nodes so the brain lays its own tables. 10-19 23:03: ( , integer, primary, key... all neurons of their own. 10-23 P2: the 14 physical actions. 10-23 P2 B3: core words become a row in the DNA of the actual word neuron. 10-27 05:05: the first core will break the rules... later that should cease to exist. His words 10-28: 'the hand laid core is the decomposition of tools down to the most basic of tools needed to be hand laid... 80 sounds about close, but it might be more like 200 or less or it might be 20'."}
      core_note2: "what is NOT hand laid: the standing questions, the born run as a formula, the ask, the compile, the decide, the substitution. The brain builds them in this first run from the tools above (lane 13)." {class: his; tooltip: "His words 10-28: 'those three questions are large processes in themselves.. so the balance is the simplest way for the brain to ask these at first, using the meanings that it has handlaid to build them itself'. 'there is no first turn that is simple.. every turn even define : who... requires all the things in order to be done correct... fake any of it, and it will be lost'."}
    }
  }
  line: "1 · THE LINE ARRIVES: prompt > encoder > brain" {
    class: lane; grid-columns: 3; grid-gap: 30
    typed: "user types   define : who" {class: note; tooltip: "Lands in the user input mailbox (his outline 10-25 21:50)."}
    enc: "encoder: define > 64 (new)   space > 3   : > 65 (new)   space > 3   who > 66 (new)" {class: encoder; tooltip: "A symbol with no gate gets the next number; nothing else is figured here (10-26 03:50; 10-23 P2). Who is speaking is part of the input: user, heard (10-26 03:50)."}
    r1: "input row R1" {class: sheet; run: "1"; gates: "64 3 65 3 66"; arrival: "1 (heard)"; speaker: "user"; clock: "t0 (47)"; tooltip: "The main run's input row. The clock neuron (47) is hit on every run (10-26 03:50). The remainder is the rest of the line as gate numbers; its head is the key at every gate (10-23 P3)."}
    typed -> enc -> r1
  }
  sq: "2 · THE STANDING QUESTIONS, BUILT BY THE BRAIN the simplest way from the hand-laid tools, before the main run runs (10-23 P3 B2; his words 10-28). Each is a long run the first time; its formula neuron is born when it works; then it is a jump." {
    class: lane; grid-columns: 4; grid-gap: 30
    q67: "67 · know" {
      class: col; grid-columns: 1; grid-gap: 14
      need: "do I know anything about this?" {class: his; tooltip: "His words 10-28: every inside step: what does the brain need to complete this; with the tools the brain has how does it build that need."}
      h0: "46 read" {class: hit; s101: "1 > 55 | - | -"; tooltip: "hit 1 of 3 of the long run of the question: the encoder gates of the line, their definition nodes. shard s101, arrived from 1."}
      h1: "55 compare" {class: hit; s102: "46 > 43 | - | -"; tooltip: "hit 2 of 3 of the long run of the question: each gate against: exists? definition rows?. shard s102, arrived from 46."}
      h0.s101 -> h1.s102: {class: hop}
      h2: "43 write" {class: hit; s103: "55 > - | - | 48 memory"; tooltip: "hit 3 of 3 of the long run of the question: the answer cell. shard s103, arrived from 55."}
      h1.s102 -> h2.s103: {class: hop}
      m: "memory node on 43.s103 (the question run)" {class: mem; run: "103"; input: "receipt of the question run"; source: "R1"; c_answer: "0"; tooltip: "The question is a run that ends; its memory row sits on the shard that ended it, with its one-cell sheet inside. Its answer is a cell on R1's sheet."}
      f: "67 · know (formula neuron, born when the run worked)" {class: built; s104: "1 > 46 | - | -"; points_at: "memory of the long run (43.s103)"; tooltip: "His words 10-28: 'a long run has an end, that run basically = a specific formula sometimes but the variables are already filled in. determining the formula neuron is figuring out what the variables of the formula is... a new neuron must be born, that is relationally matched to that long run'. Gate 67 is born after the question worked once; on every later run the question is a jump to it, and the variables (the gates of the new line) are plugged in. No spelling in the encoder."}
      h2.s103 -> m: {class: trig; label: "no remainder"}
      m -> f: {class: builtw; label: "born: the formula"}
    }
    q68: "68 · remember" {
      class: col; grid-columns: 1; grid-gap: 14
      need: "do I have memories of this?" {class: his; tooltip: "His words 10-28: every inside step: what does the brain need to complete this; with the tools the brain has how does it build that need."}
      h0: "46 read" {class: hit; s105: "1 > 55 | - | -"; tooltip: "hit 1 of 3 of the long run of the question: memory nodes, timeline receipts. shard s105, arrived from 1."}
      h1: "55 compare" {class: hit; s106: "46 > 43 | - | -"; tooltip: "hit 2 of 3 of the long run of the question: receipt against 64 3 65 3 66. shard s106, arrived from 46."}
      h0.s105 -> h1.s106: {class: hop}
      h2: "43 write" {class: hit; s107: "55 > - | - | 48 memory"; tooltip: "hit 3 of 3 of the long run of the question: the answer cell. shard s107, arrived from 55."}
      h1.s106 -> h2.s107: {class: hop}
      m: "memory node on 43.s107 (the question run)" {class: mem; run: "107"; input: "receipt of the question run"; source: "R1"; c_answer: "0"; tooltip: "The question is a run that ends; its memory row sits on the shard that ended it, with its one-cell sheet inside. Its answer is a cell on R1's sheet."}
      f: "68 · remember (formula neuron, born when the run worked)" {class: built; s108: "1 > 46 | - | -"; points_at: "memory of the long run (43.s107)"; tooltip: "His words 10-28: 'a long run has an end, that run basically = a specific formula sometimes but the variables are already filled in. determining the formula neuron is figuring out what the variables of the formula is... a new neuron must be born, that is relationally matched to that long run'. Gate 68 is born after the question worked once; on every later run the question is a jump to it, and the variables (the gates of the new line) are plugged in. No spelling in the encoder."}
      h2.s107 -> m: {class: trig; label: "no remainder"}
      m -> f: {class: builtw; label: "born: the formula"}
    }
    q69: "69 · shape" {
      class: col; grid-columns: 1; grid-gap: 14
      need: "does this run shape match a shape I have? a formula proven to try first?" {class: his; tooltip: "His words 10-28: every inside step: what does the brain need to complete this; with the tools the brain has how does it build that need."}
      h0: "46 read" {class: hit; s109: "1 > 61 | - | -"; tooltip: "hit 1 of 4 of the long run of the question: timeline receipts; formula neurons. shard s109, arrived from 1."}
      h1: "61 find" {class: hit; s110: "46 > 55 | - | -"; tooltip: "hit 2 of 4 of the long run of the question: the pattern X 3 65 3 Y. shard s110, arrived from 46."}
      h0.s109 -> h1.s110: {class: hop}
      h2: "55 compare" {class: hit; s111: "61 > 43 | - | -"; tooltip: "hit 3 of 4 of the long run of the question: shape against shape. shard s111, arrived from 61."}
      h1.s110 -> h2.s111: {class: hop}
      h3: "43 write" {class: hit; s112: "55 > - | - | 48 memory"; tooltip: "hit 4 of 4 of the long run of the question: the answer cell. shard s112, arrived from 55."}
      h2.s111 -> h3.s112: {class: hop}
      m: "memory node on 43.s112 (the question run)" {class: mem; run: "112"; input: "receipt of the question run"; source: "R1"; c_answer: "0"; tooltip: "The question is a run that ends; its memory row sits on the shard that ended it, with its one-cell sheet inside. Its answer is a cell on R1's sheet."}
      f: "69 · shape (formula neuron, born when the run worked)" {class: built; s113: "1 > 46 | - | -"; points_at: "memory of the long run (43.s112)"; tooltip: "His words 10-28: 'a long run has an end, that run basically = a specific formula sometimes but the variables are already filled in. determining the formula neuron is figuring out what the variables of the formula is... a new neuron must be born, that is relationally matched to that long run'. Gate 69 is born after the question worked once; on every later run the question is a jump to it, and the variables (the gates of the new line) are plugged in. No spelling in the encoder."}
      h3.s112 -> m: {class: trig; label: "no remainder"}
      m -> f: {class: builtw; label: "born: the formula"}
    }
    path: "which path" {
      class: col; grid-columns: 1; grid-gap: 14
      pick: "all three 0 > the long way" {class: pick; tooltip: "10-23 P3 B2: if they all come back no, then we have to go the long way... yes we know something, yes we have a shortcut, yes a formula shortcut, then the formula shortcut path, if belief and truth show it can be done correctly."}
      short: "shortcut: one hop to the memory (replay the long run)" {class: note; tooltip: "Not taken on this line. His words 10-28: 'the shortcut path if the variable formula path is not found yet'."}
      formula_path: "formula path: jump to the formula neuron, plug the variables in" {class: note; tooltip: "Not taken on this line for R1 (nothing is bound to 64 yet). Taken by the born runs for 65 and 66 (column B)."}
      circle: "and it all circles back here: every run, side runs too, begins with the three questions" {class: his; tooltip: "His words 10-28: 'on the pointer the circle is back to the memory of the run ... or maybe the run data sheet and it all circles back to the standing questions, do I know anything about this, do I have memories about this, do I have a formula that is proven to try first'."}
      pick -> short: {class: not}
      pick -> formula_path: {class: not}
    }
    q67.m -> path.pick: {class: fill}
    q68.m -> path.pick: {class: fill}
    q69.m -> path.pick: {class: fill}
  }
  line.r1 -> sq.q67.need: {class: spawn}
  line.r1 -> sq.q68.need: {class: spawn}
  line.r1 -> sq.q69.need: {class: spawn}
  main: "3 · THE MAIN RUN R1, the hallway: 64 > 3 > 65 > 3 > 66. Born inline at every missing gate (mechanical intelligence: missing neuron = missing step). The receipt is written by the brain into R1's sheet." {
    class: lane; grid-columns: 3; grid-gap: 30
    hall: "the hallway, top to bottom" {
      class: col; grid-columns: 1; grid-gap: 14
      ha: "64 · define" {class: newborn; s114: "1 > 3 | - | -"; tooltip: "define, gate 64, born this line. No gate existed: born INLINE, 'missing neuron = missing step... new neuron must be born such that the next step can be completed' (his words 10-28); the run does not go back to its start. Then the write run lays s114: arrived from 1 (heard), goes on to 3. Its trigger column holds nothing yet: a symbol with no action (10-27 05:37)."}
      hb: "3 · space" {class: neuron; s115: "64 > 65 | - | -"; tooltip: "the space, gate 3, a core neuron. ( ) is a meaning that we know happens to the graph or the silicon (10-27 05:37). s115: 64 > 65."}
      hc: "65 · :" {class: newborn; s116: "3 > 3 | - | -"; tooltip: ":, gate 65, born inline. In sql ':' has an action we know; on this line it has none yet (10-27 05:37). s116: 3 > 3."}
      hd: "3 · space" {class: neuron; s117: "65 > 66 | - | -"; tooltip: "the same neuron 3, hit a second time, drawn where it is hit (his sketch). s117: 65 > 66."}
      he: "66 · who" {class: newborn; s118: "3 > - | - | 48 memory"; tooltip: "who, gate 66, born inline. s118 has no remainder: 'the dna shard that has no remainder is what triggers the write of the memories' (10-15 21:50). This shard's memory node holds R1's row with the whole sheet inside. Later rows: 'who is, who are, who did and who was each fire a different row inside the one neuron for who' (10-22 rev17)."}
    }
    hall.ha.s114 -> hall.hb.s115: {class: hop}
    hall.hb.s115 -> hall.hc.s116: {class: hop}
    hall.hc.s116 -> hall.hd.s117: {class: hop}
    hall.hd.s117 -> hall.he.s118: {class: hop}
    rec: "the receipt: written by the brain, read by the brain" {
      class: col; grid-columns: 1; grid-gap: 14
      hop42: "42 · hop" {class: neuron; s119: "- > - | 43 write | -"; tooltip: "The hop neuron: 'hop neuron is just a hop neuron... different dna row' (10-26 05:12). Each hop calls the write run, which writes the receipt row into R1's sheet. His words 10-28: 'if physics writes the brain will not be able to see or observe what happened,, anything the brain cannot see is a step the brain cannot build upon... run receipt is just the order of the main run plus the hops, so it's just recorded in the run data sheet as a row and columns, then read and written by the brain'."}
      wr43: "43 · write" {class: neuron; s120: "42 > - | - | -"; tooltip: "The write run lays one row of R1's sheet per hop."}
      receipt: "R1's sheet, the receipt rows" {class: sheet; h1: "1 > 64.s114"; h2: "64 > 3.s115"; h3: "3 > 65.s116"; h4: "65 > 3.s117"; h5: "3 > 66.s118 (end)"; tooltip: "The path of gates and shards: a pointer to the run, never the run again (10-23 P2). Rows and columns of the run data sheet, written by the write run (his words 10-28)."}
      hop42.s119 -> wr43.s120: {class: call}
      wr43.s120 -> receipt: {class: fill}
    }
    hall.hb.s115 -> rec.hop42.s119: {class: call; label: "every hit: the hop calls write"}
    notes: "" {
      class: col; grid-columns: 1; grid-gap: 14
      inline: "BORN INLINE (this lane) vs STEP BACK (lane 6): two different cases" {class: his; tooltip: "His words 10-28: 'born inline is mechanical intelligence perspective... meaning missing neuron = missing step ... new neuron must be born such that the next step can be completed.... traverse back and retry.... has to do with a failed cell on the run data sheet, if the new step, or the next step fails to provide the run data sheet with data then the run must be re ran via different substitution theory or using a different formula, via process of elimination theory ... meaning there is a check back or even step back to a run that had a choice ... the failed choice is remembered from the time line and eliminated'."}
    }
  }
  sq.path.pick -> main.hall.ha: {class: hop; label: "long way"}
  ending: "9 · THE END OF R1 and THE TIMELINE: no remainder > memory write run > timeline write run > stop (10-26 03:50)" {
    class: lane; grid-columns: 2; grid-gap: 30
    writes: "the two write runs" {
      class: col; grid-columns: 1; grid-gap: 14
      m48: "48 · memory (write run)" {class: neuron; s307: "66 > 49 | 44 copy | -"; tooltip: "A copy run the ending shard excites; the trigger writes nothing itself (10-26 03:59). It lays run_memory(1, receipt, user) on 66.s118 and the run_sheet rows inside it (his v4 shape)."}
      t49: "49 · timeline (write run)" {class: neuron; s308: "48 > - | - | -"; tooltip: "By a trigger hop, never a sweep (10-23 P3 B1). One row: the clock reading, the receipt pointer, a couple of key words (10-16 06:40). Then it stops (10-26 03:50)."}
      m48.s307 -> t49.s308: {class: trig; label: "memory > timeline"}
    }
    timeline: "TIMELINE after this line" {class: tl; r1: "t0 | SQ1 know > 43.s103 | 67"; r2: "t0 | SQ2 remember > 43.s107 | 68"; r3: "t0 | SQ3 shape > 43.s112 | 69"; r4: "t1 | R2 born 64 > 40.s260 | 41 64"; r5: "t | R4 born 65 > 40.s275 | 41 65"; r5: "t2 | R3 sources 64: 12 return runs, compile | 51 64"; r6: "t | R6 born 66 > 40.s285 | 41 66"; r7: "t4 | R5 sources 65: 0 returns (eliminated) > sixth > guess | 51 65"; r9: "t6 | R7 sources 66: 4 return runs, compile | 51 66"; r10: "t7 | R1 define : who > 66.s118 | 64 66"; r11: "t8 | R8 say > 56.s | 56"; tooltip: "A row per run that ended, in the order the drawing says they happen. The cascade's born runs add their own rows, not listed. The failed choice of R5 stays in the timeline, marked eliminated (his words 10-28)."}
    writes.t49.s308 -> timeline: {class: fill; label: "one row; then stops"}
  }
  main.hall.he -> ending.writes.m48: {class: trig; label: "no remainder"}
  output: "10 · OUTPUT: a separate mechanism from the same memory table (10-26 03:50). Before 'define?' goes to the user the run asks the sixth why; guesses go out labeled with the question correct? incorrect? progression? degression?" {
    class: lane; grid-columns: 3; grid-gap: 30
    o1: "from the memory table" {
      class: col; grid-columns: 1; grid-gap: 14
      when: "no declared cell of R1 empty? (def.65 filled by the labeled guess)" {class: pick; tooltip: "10-26 03:50: when the run's data table is complete the run can populate and finish its larger formulas."}
      formulas: "the larger formulas over the sheet (substitute the cells as variables)" {class: note; tooltip: "10-23 P3 B2. On a fresh brain nothing is bound to define yet; the material is the sheet: the compiled definitions of 64 and 66 and the labeled guess for 65."}
      balance: "makes sense: desired vs current vs new; progression or regression" {class: note; tooltip: "10-23 P5-9 B1. Not balanced: step back to the decision that picked this path and take another row; the failed try stays in memory marked wrong (10-22 rev17; his words 10-28)."}
      when -> formulas: {class: hop}
      formulas -> balance: {class: hop}
    }
    o2: "before it goes out" {
      class: col; grid-columns: 1; grid-gap: 14
      askwhy: "the run asks the sixth: why would I say 'define?'" {class: sixth; ask: "R1: is this balanced? what is missing?"; sixth: "cells: def.65 is a guess; say it labeled"; tooltip: "His words 10-28: 'before a run answers define? back to the user, it askes the sixth why define? and the sixth replies your run data sheet at location x,y,z is missing cells... or it calls to the sixth or the guessing brain for a balance/progression check'."}
      s56: "56 · say" {class: neuron; s309: "48 > 60 | 55 compare | -"; tooltip: "The say run: the reply as a tree of arrays, each pick opening the next (10-23 P3 B2); the brain chooses what it wants to say (10-27 03:52); no sentence drawn here on purpose (10-27 04:07). 10-26 05:12: the say key = the metadata on what leaves (lane 0)."}
      askwhy -> s56.s309: {class: trig; label: "balanced"}
    }
    o3: "out" {
      class: col; grid-columns: 1; grid-gap: 14
      dec: "DECODER: gates > symbols" {class: encoder; tooltip: "10-23 P3 B2: just gate numbers, maybe head data."}
      to_user: "brain > user mailbox: the answer, with the guess labeled and the question: correct? incorrect? progression? degression?" {class: mail; tooltip: "His words 10-28: 'all guesses in an output are labeled and asked correct?/incorrect?/progression?/ degression? <-- that answer is what helps adjust the weights and build the confidence to change a guess into a belief'."}
      to_sixth: "> sixth.db mailbox" {class: mail; tooltip: "10-25 msg 41: run output to sixth."}
      answer: "the user's answer comes back as a line (heard): it adjusts the guess's weights and belief; a correct raises the formula's belief too" {class: his; tooltip: "His words 10-28. 10-23 P5-9 B1: taught is not believed; belief from memory, source trust, supporting knowledge."}
      dec -> to_user: {class: hop}
      to_user -> answer: {class: route}
    }
    o1.balance -> o2.askwhy: {class: route; label: "through mother"}
    o2.s56.s309 -> o3.dec: {class: hop}
    o2.s56.s309 -> o3.to_sixth: {class: spawn}
  }
  ending.timeline -> output.o1.when: {class: trig; label: "the memory row exists"}
  open: "12 · HIS ANSWERS OF 10-28 (closed) and WHAT IS STILL HIS CALL" {
    class: lane; grid-columns: 2; grid-gap: 30
    closed: "closed by his words of 10-28" {
      class: col; grid-columns: 1; grid-gap: 14
      c1: "1. born inline AND step back: two cases, not one choice" {class: closed; tooltip: "Born inline when a gate is missing (missing neuron = missing step). Step back to a run that had a choice when a cell fails; the failed choice is remembered from the timeline and eliminated; rerun by a different substitution or formula. Drawn: lane 3 and lane 6."}
      c2: "2. the receipt is written by the brain's write run into the run data sheet, never by physics" {class: closed; tooltip: "'if physics writes the brain will not be able to see or observe what happened... run receipt is just the order of the main run plus the hops, so it's just recorded in the run data sheet as a row and columns'. Drawn: lane 3."}
      c3: "3. the sheet's physical form: his v4 brain.db (rows keyed by the run, pointed to by the memory row)" {class: closed; tooltip: "The question explained in lane 0 (the memory table shape). His own typing of 10-27 01:17 is the answer the drawing follows."}
      c4: "4. the formula is a NEW neuron, born, relationally matched to the long run; not a row in one formula neuron" {class: closed; tooltip: "'once the variables are determined then that row cannot live in the main run... thus a new neuron must be born'. Drawn: lane 5 (70) and lane 2 (67, 68, 69)."}
      c5: "5. the standing questions are built by the brain from the hand-laid tools, in this first run, the simplest way; every run circles back to them" {class: closed; tooltip: "Drawn: lane 2 (the long runs and the formula neurons born), lane 5b (the jumps)."}
      c6: "6. define is not in the core: there is no simple first turn; the first run builds what it needs step by step" {class: closed; tooltip: "'every turn even define : who or learn : who or meaning : who requires all the things in order to be done correct... give the brain the ability to build it all through systems or processes it builds step by step by step inside the first run'. Drawn: lane 13 and the inside of every step (KEY)."}
      c7: "7. 'the first time it works and is correct' is not 'ok': it is the next step completing, and later the user's correct/incorrect and the sixth's observation" {class: closed; tooltip: "Drawn: lane 5 (worked), lane 10 (correct?), lane 11."}
      c8: "8. the say key = the metadata that travels with what leaves and returns through mother" {class: closed; tooltip: "His guesses for its columns: what is this data in perspective to this run, where does it belong, what does it solve, who said it, when, why, what modifiers. Drawn: lane 0 (the key shape), lanes 4, 6."}
    }
    still: "still his call" {
      class: col; grid-columns: 1; grid-gap: 14
      o1: "1. the compile, explained: when the sources disagree, what goes in the definition node?" {class: open; tooltip: "The example on this line: for who, WordNet sent 'a United Nations agency' (the WHO), Webster 'an interrogative pronoun, later a relative pronoun', Merriam-Webster 'what or which person or persons' and 'the person or persons that: whoever'. The earlier build kept only the words two sources shared and dropped the rest, and on 10-23 P4 B1 he said 'the diffs are kind of dropped or scattered and the similars are kept. But I don't know that we're getting a good, valid definition that way... if the definitions are wrong, then the description of the meaning is wrong'. The drawing keeps every source's line as its own row, kept apart by source, and lets the compile lay relationship rows from them; what the compile DROPS, if anything, and what counts as 'similar' (the same gates? the same relationships?) is the open part."}
      o2: "2. the key's columns" {class: open; tooltip: "His guesses listed in lane 0; which are needed is found as the brain grows."}
      o3: "3. how deep a symbol born from a definition text is sourced" {class: open; tooltip: "10-23 P4: 'in order to have the definitions, you have to have 500 or 1,000 words that you don't have meanings for'. The drawing stops one level down."}
      o4: "4. the formula neuron's rows for other variables and modifiers: another row, or another neuron" {class: open; tooltip: "His words 10-28: 'you have to take in account variables and modifiers sometimes in this aspect such to get the full use of a formula in any one context'."}
      o5: "5. the count of hand-laid tools: 20, 80 or 200; which turn out to be buildable later" {class: open; tooltip: "His words 10-28. The core drawn here is 63 and is a reading."}
      o6: "6. what the inspection run reads first: the script, the context, or the memories" {class: open; tooltip: "His words 10-28 name all three."}
    }
  }
}
B: "" {
  class: column; grid-columns: 1; grid-gap: 70
  born64: "4 · BORN RUN R2 for 64, THE LONG WAY: one hit per symbol through the SQL-word neurons; the value neuron holds the hole; build routes to mother (10-19 21:52; 23:03; his words 10-28: like 50 neurons gates, a different shard in the value neuron for each new run)" {
    class: lane; grid-columns: 4; grid-gap: 30
    colA: "born, and the out key" {
      class: col; grid-columns: 1; grid-gap: 14
      b41: "41 · born" {class: neuron; s121: "64 > 4 | - | 51 ask"; tooltip: "The born run, excited by the no-gate condition at 64 (10-20 01:22). Arrived from 64, goes on to 4 (CREATE); spawn column: the ask run (51) for the newborn's sources (10-23 P4). It declares on R1's sheet the cell gate.64 and its own sheet: value, text, reply."}
      keyrow: "the key this run puts on the out mailbox" {class: key; run: "R2"; cell: "reply"; gate: "40 build"; when: "t1"; why: "R1 needs gate 64"; modifiers: "-"; tooltip: "His words 10-28 (the say key): the metadata that travels with the script to mother and back with the response, so the return fills the right cell of the right run."}
    }
    st1: "statement 1: CREATE TABLE ' 64 ' ( shard INTEGER , before INTEGER , trigger INTEGER , call INTEGER , spawn INTEGER ) ;  (41 hits)" {
      class: col; grid-columns: 2; grid-gap: 24
      c0: "" {
        class: col; grid-columns: 1; grid-gap: 14
        h0: "4 · CREATE" {class: hit; s122: "41 > 3 | - | -"; tooltip: "hit 1 of 41 in R2: gate 4 (CREATE), shard s122, arrived from 41, goes on to 3."}
        h1: "3 · space" {class: hit; s123: "4 > 5 | - | -"; tooltip: "hit 2 of 41 in R2: gate 3 (space), shard s123, arrived from 4, goes on to 5."}
        h2: "5 · TABLE" {class: hit; s124: "3 > 3 | - | -"; tooltip: "hit 3 of 41 in R2: gate 5 (TABLE), shard s124, arrived from 3, goes on to 3."}
        h3: "3 · space" {class: hit; s125: "5 > 6 | - | -"; tooltip: "hit 4 of 41 in R2: gate 3 (space), shard s125, arrived from 5, goes on to 6."}
        h4: '6 · "' {class: hit; s126: "3 > 18 | - | -"; tooltip: "hit 5 of 41 in R2: gate 6 ('), shard s126, arrived from 3, goes on to 18."}
        h5: "18 · value" {class: hit; s127: "6 > 6 | 43 write | -"; tooltip: "hit 6 of 41 in R2: gate 18 (value), shard s127, arrived from 6, goes on to 6. THE HOLE: 'create table (var a)... a table of what ever is sitting at the newest memory at var a' (10-19 23:08); 'a different shard in the value neuron for each new run' (his words 10-28). Its call: the write run (43) writes this run's value, 64, into the run's sheet cell value; the substitution fills the hole from the sheet (10-24 msg 36)."}
        h6: '6 · "' {class: hit; s128: "18 > 3 | - | -"; tooltip: "hit 7 of 41 in R2: gate 6 ('), shard s128, arrived from 18, goes on to 3."}
        h7: "3 · space" {class: hit; s129: "6 > 7 | - | -"; tooltip: "hit 8 of 41 in R2: gate 3 (space), shard s129, arrived from 6, goes on to 7."}
        h8: "7 · (" {class: hit; s130: "3 > 3 | - | -"; tooltip: "hit 9 of 41 in R2: gate 7 ((), shard s130, arrived from 3, goes on to 3."}
        h9: "3 · space" {class: hit; s131: "7 > 13 | - | -"; tooltip: "hit 10 of 41 in R2: gate 3 (space), shard s131, arrived from 7, goes on to 13."}
        h10: "13 · shard" {class: hit; s132: "3 > 3 | - | -"; tooltip: "hit 11 of 41 in R2: gate 13 (shard), shard s132, arrived from 3, goes on to 3."}
        h11: "3 · space" {class: hit; s133: "13 > 11 | - | -"; tooltip: "hit 12 of 41 in R2: gate 3 (space), shard s133, arrived from 13, goes on to 11."}
        h12: "11 · INTEGER" {class: hit; s134: "3 > 3 | - | -"; tooltip: "hit 13 of 41 in R2: gate 11 (INTEGER), shard s134, arrived from 3, goes on to 3."}
        h13: "3 · space" {class: hit; s135: "11 > 9 | - | -"; tooltip: "hit 14 of 41 in R2: gate 3 (space), shard s135, arrived from 11, goes on to 9."}
        h14: "9 · ," {class: hit; s136: "3 > 3 | - | -"; tooltip: "hit 15 of 41 in R2: gate 9 (,), shard s136, arrived from 3, goes on to 3."}
        h15: "3 · space" {class: hit; s137: "9 > 14 | - | -"; tooltip: "hit 16 of 41 in R2: gate 3 (space), shard s137, arrived from 9, goes on to 14."}
        h16: "14 · before" {class: hit; s138: "3 > 3 | - | -"; tooltip: "hit 17 of 41 in R2: gate 14 (before), shard s138, arrived from 3, goes on to 3."}
        h17: "3 · space" {class: hit; s139: "14 > 11 | - | -"; tooltip: "hit 18 of 41 in R2: gate 3 (space), shard s139, arrived from 14, goes on to 11."}
        h18: "11 · INTEGER" {class: hit; s140: "3 > 3 | - | -"; tooltip: "hit 19 of 41 in R2: gate 11 (INTEGER), shard s140, arrived from 3, goes on to 3."}
        h19: "3 · space" {class: hit; s141: "11 > 9 | - | -"; tooltip: "hit 20 of 41 in R2: gate 3 (space), shard s141, arrived from 11, goes on to 9."}
        h20: "9 · ," {class: hit; s142: "3 > 3 | - | -"; tooltip: "hit 21 of 41 in R2: gate 9 (,), shard s142, arrived from 3, goes on to 3."}
      }
      c1: "" {
        class: col; grid-columns: 1; grid-gap: 14
        h21: "3 · space" {class: hit; s143: "9 > 15 | - | -"; tooltip: "hit 22 of 41 in R2: gate 3 (space), shard s143, arrived from 9, goes on to 15."}
        h22: "15 · trigger" {class: hit; s144: "3 > 3 | - | -"; tooltip: "hit 23 of 41 in R2: gate 15 (trigger), shard s144, arrived from 3, goes on to 3."}
        h23: "3 · space" {class: hit; s145: "15 > 11 | - | -"; tooltip: "hit 24 of 41 in R2: gate 3 (space), shard s145, arrived from 15, goes on to 11."}
        h24: "11 · INTEGER" {class: hit; s146: "3 > 3 | - | -"; tooltip: "hit 25 of 41 in R2: gate 11 (INTEGER), shard s146, arrived from 3, goes on to 3."}
        h25: "3 · space" {class: hit; s147: "11 > 9 | - | -"; tooltip: "hit 26 of 41 in R2: gate 3 (space), shard s147, arrived from 11, goes on to 9."}
        h26: "9 · ," {class: hit; s148: "3 > 3 | - | -"; tooltip: "hit 27 of 41 in R2: gate 9 (,), shard s148, arrived from 3, goes on to 3."}
