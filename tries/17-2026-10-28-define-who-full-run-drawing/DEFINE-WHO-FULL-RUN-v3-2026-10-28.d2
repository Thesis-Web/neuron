      c2.h87.s250 -> c2.h88.s251: {class: hop}
      c2.h88.s251 -> c2.h89.s252: {class: hop}
      c2.h89.s252 -> c2.h90.s253: {class: hop}
      c2.h90.s253 -> c2.h91.s254: {class: hop}
      c2.h91.s254 -> c2.h92.s255: {class: hop}
      c2.h92.s255 -> c2.h93.s256: {class: hop}
      c2.h93.s256 -> c2.h94.s257: {class: hop}
      c2.h94.s257 -> c2.h95.s258: {class: hop}
      c2.h95.s258 -> c2.h96.s259: {class: hop}
    }
    colA.b41.s121 -> st1.c0.h0.s122: {class: hop}
    st1.c1.h40.s162 -> st2.c0.h0.s163: {class: hop; label: "; > CREATE"}
    endcol: "the end of R2" {
      class: col; grid-columns: 1; grid-gap: 14
      b40: "40 · build" {class: neuron; s260: "10 > 60 | - | 48 memory"; tooltip: "The build neuron: 'the last build word was the build neuron... routing information for the mother... build neuron = routing to sql prompt' (10-26 03:50). Its row, picked by before (10 ;) and no remainder, is a build row because of how before and remainder are set, not by counting. No remainder: this shard ends R2 and carries R2's memory node. The build neuron ends every born run, so it gains one memory node per born run (his words 10-28)."}
      o60: "60 · out (the port)" {class: neuron; s261: "40 > - | - | -"; tooltip: "The port the run hits to leave: the product and the key go on the brain > mother mailbox. 10-23 msg 1: output to sources is a dna row and trigger to port."}
      text: "the product: the two statements as text, hole filled from cell value = 64, with the key" {class: note; tooltip: "10-19 23:03: the statement as the product of the run. 10-24 msg 36: the run data sheet produces the exact code that sql needs to run as output the same way that it forms human sentences; given to the mother to route to the sql prompt."}
      reply: "SQL answers ok > mother > encoder (secondary, with the key) > fills R2.reply" {class: sheet; key: "R2 | reply | 40 | t1"; tooltip: "10-24 msg 36; 10-26 03:50: each return fills its spot. The key says which run and which cell. An error is not an end (10-27 03:52)."}
      m2: "memory node on 40.s260 (R2)" {class: mem; run: "R2"; input: "receipt: 41.s121 4.s122 ... 10.s259 40.s260"; source: "R1 (no gate at 64)"; c_value: "64"; c_text: "> the product"; c_reply: "ok"; c_next_step: "1: 64 exists, R1 wrote 64.s114"; c_formula: "> receipt with the hole at 18.s127, 18.s168"; tooltip: "R2's memory row on the shard that ended it, with its sheet inside. Cells declared by the triggers that tripped (10-26 03:50)."}
      tl2: "timeline row: t1 | R2 > 40.s260 | 41 64" {class: tl; tooltip: "One row per run that ends (10-16 06:40)."}
      b40.s260 -> o60.s261: {class: hop}
      o60.s261 -> text: {class: route}
      text -> reply: {class: route; label: "mother > neuron prompt > SQL > mother"}
      reply -> m2: {class: fill}
      m2 -> tl2: {class: trig; label: "memory > timeline, stops"}
    }
    st2.c2.h96.s259 -> endcol.b40.s260: {class: hop}
    wcol: "the write run the hole calls" {
      class: col; grid-columns: 1; grid-gap: 14
      w43: "43 · write" {class: neuron; s262: "18 > - | - | -"; tooltip: "The write run: excited by the value neuron's call; writes value = 64 into R2's sheet (10-26 03:59: the trigger just triggers that run, often used with the copy run, and cut run)."}
    }
    st1.c0.h5.s127 -> wcol.w43.s262: {class: call; label: "call"}
    st2.c0.h5.s168 -> wcol.w43.s262: {class: call}
    wcol.w43.s262 -> endcol.m2: {class: fill; label: "value = 64"}
  }
  formula: "5 · THE FORMULA: when the long run worked (the next step completed) a decide formula run finds the variables; a NEW NEURON is born for the formula, relationally matched to the long run; back population lays the jump (his words 10-28)" {
    class: lane; grid-columns: 3; grid-gap: 30
    decide: "the decide formula run" {
      class: col; grid-columns: 1; grid-gap: 14
      worked: "R2 worked: the next step of R1 completed (64 exists; R1 wrote 64.s114)" {class: his; tooltip: "His words 10-28: 'it's done by way of the first time it works, and is correct'; in context: 'when it works and is correct the graph will have meanings of its own, the graph shape of runs will start to show us more information'. [reading] 'works' = the next step of the run that needed it completed; 'correct' grows with the user's correct/incorrect and the sixth's observation (lanes 10, 11)."}
      d53: "53 · decide (formula)" {class: neuron; s263: "40 > 55 | 46 read | -"; tooltip: "His words 10-28: 'it triggers a decide formula run that decides what the formula is, then writes it in that runs data sheet'. It reads R2's receipt (46), compares (55) the hits against the run's input to find which hits carried the variable (the value neuron's shards), and the write run (43) writes the formula into R2's sheet cell formula: the receipt with the holes marked."}
      c55: "55 · compare" {class: neuron; s264: "53 > 43 | - | -"; tooltip: "Which hits are the variables: the ones whose value came from the sheet, not from the line."}
      w43: "43 · write" {class: neuron; s265: "55 > - | - | -"; tooltip: "Writes cell formula into R2's memory node."}
      d53.s263 -> c55.s264: {class: hop}
      c55.s264 -> w43.s265: {class: hop}
    }
    fcol: "the formula neuron, born" {
      class: col; grid-columns: 1; grid-gap: 14
      f70: "70 · formula: create table (value) (born)" {class: built; s266: "41 > 18 | 54 substitute | -"; other_rows: "(other variables or modifiers: another row, or another formula neuron)"; tooltip: "His words 10-28: 'a long run has an end, that run basically = a specific formula sometimes but the variables are already filled in. determining the formula neuron is figuring out what the variables of the formula is... once the variables are determined then that row cannot live in the main run because it doesn't match the run receipt of that run... thus a new neuron must be born, that is relationally matched to that long run, but can be used with different variables on other runs also.... you have to take in account variables and modifiers'. Born by the born run (the long way, the last time: [reading] its own birth has no formula yet). Its row: arrived from born (41), goes on to the value neuron (18) with a new shard per run; calls the substitution run (54)."}
      fdef: "definition node of 70: relationally matched to the long run" {class: defn; formula_of: "> R2 memory node 40.s260 (the run data sheet)"; variables: "18.s127, 18.s168 (the holes)"; rel: "kind > 4 CREATE, 5 TABLE (the words it stands for)"; tooltip: "The pointer circles back to the memory of the long run (his words 10-28: 'on the pointer the circle is back to the memory of the run ... or maybe the run data sheet'). The standing question SQ3 finds it next time: 'do I have a formula that is proven to try first'."}
      bp: "back population: the write run lays on 4.s122 the jump > 70.s266" {class: note; tooltip: "His words 10-28: 'through back population the triggers or calls or jumps or hops from a run create table (value) would have to show the substitution run and the write run writing the value, then the trigger of the substitution run copying into the substitution run so that you can then skip the long run and use the formula neuron'. 10-23 P5-9: back population is the application of a newly understood process to the other things it fits."}
      f70 -> fdef: {class: readw; label: "born with it"}
      f70.s266 -> bp: {class: trig}
    }
    sqcol: "and the standing questions now find it" {
      class: col; grid-columns: 1; grid-gap: 14
      sq3: "69 · shape (formula neuron): on the next born run, cell = 70" {class: built; answer: "formula proven: 70"; tooltip: "His words 10-28: 'it all circles back to the standing questions... do I have a formula that is proven to try first.... this is the step at the beginning that skips the long run'."}
      sq2: "68 · remember: on the next born run, cell = R2's memory" {class: built; answer: "memory: 40.s260"; tooltip: "If no formula were born yet, the shortcut path would replay the long run from this memory (his words 10-28: 'the shortcut path if the variable formula path is not found yet')."}
    }
  }
  born64.endcol.m2 -> formula.decide.worked: {class: trig; label: "reply ok, next step done"}
  formula.decide.worked -> formula.decide.d53.s263: {class: trig}
  formula.decide.w43.s265 -> born64.endcol.m2: {class: fill; label: "writes cell formula"}
  formula.decide.w43.s265 -> formula.fcol.f70: {class: builtw; label: "a new neuron is born for the formula"}
  formula.fcol.bp -> born64.st1.c0.h0: {class: jump; label: "jump laid on 4.s122"}
  formula.fcol.fdef -> formula.sqcol.sq3: {class: readw; label: "SQ3 reads it"}
  born_short: "5b · BORN RUNS R4 (65) and R6 (66) BY THE FORMULA PATH: the three questions (now jumps), born > CREATE jumps to the formula neuron, the value neuron gets a new shard and calls write, substitution plugs the value in, build routes (his words 10-28)" {
    class: lane; grid-columns: 2; grid-gap: 30
    R4: "R4: born 65" {
      class: col; grid-columns: 1; grid-gap: 14
      b41: "41 · born" {class: neuron; s267: "65 > 67 | - | 51 ask"; tooltip: "The same born neuron, a new shard for this run: arrived from 65. Every run begins with the three questions (his words 10-28), so it goes on to 67 (know). Spawns the ask run (51)."}
      q1: "67 · know (formula neuron)" {class: built; s268: "41 > 68 | - | -"; cell: "born: known"; tooltip: "The question is a jump now: the formula neuron born in lane 2, variables plugged in."}
      q2: "68 · remember (formula neuron)" {class: built; s269: "67 > 69 | - | -"; cell: "memory of a born run: 40.s260"}
      q3: "69 · shape (formula neuron)" {class: built; s270: "69 > 4 | - | -"; cell: "formula proven: 70 > the formula path"; tooltip: "His words 10-28: 'uses the variable formula path or the shortcut path if the variable formula path is not found yet'."}
      c4: "4 · CREATE" {class: hit; s122: "41 > 3 | - | -   jump > 70.s266"; tooltip: "The same shard 4.s122 the long run wrote, now carrying the jump laid by back population: the long run is skipped. 10-08: 'if I know where I am standing I can hop to any point in my brain in one step... all the work was done at learning, not at runtime'."}
      f70: "70 · formula: create table (value)" {class: built; s266: "41 > 18 | 54 substitute | -"; tooltip: "The formula neuron born after R2. Goes on to the value neuron; calls the substitution run."}
      v18: "18 · value" {class: neuron; s271: "70 > 54 | 43 write | -"; tooltip: "A different shard in the value neuron for each new run (his words 10-28): s271 for R4. Its call: the write run writes the value variable, 65, into R4's sheet."}
      w43: "43 · write" {class: neuron; s272: "18 > - | - | -"; tooltip: "Writes value = 65 into R4's sheet cell value ('the formula shortcut is just to the data sheet writing the value variable', his words 10-28)."}
      sub54: "54 · substitute" {class: neuron; s273: "18 > 40 | 44 copy | -"; tooltip: "'substitution run grabbing that value and plugging it into the run data sheet so a new memory node can be made or a new neuron can be made' (his words 10-28). Its call: the copy run copies the formula (R2's sheet cell formula, the receipt with the holes) into this run's sheet; the holes are filled with cell value."}
      cp44: "44 · copy" {class: neuron; s274: "54 > - | - | -"; tooltip: "Copies R2.sheet.formula into R4's sheet cell text ('the trigger of the substitution run copying into the substitution run', his words 10-28)."}
      b40: "40 · build" {class: neuron; s275: "54 > 60 | - | 48 memory"; tooltip: "The build neuron again, a new shard for R4: it ends the run, so it carries another memory node. The build neuron now holds memory nodes for R2, R4, ..."}
      o60: "60 · out" {class: neuron; s276: "40 > - | - | -"; tooltip: "The port: the product and the key (R4 | reply | 40 | t) go to mother."}
      m: "memory node on 40.s275 (R4)" {class: mem; run: "R4"; input: "receipt: 41.s267 67.s268 68.s269 69.s270 4.s122 70.s266 18.s271 54.s273 40.s275 60.s276"; source: "R1 (no gate at 65)"; c_value: "65"; c_text: "> R2.formula with 65 in the holes"; c_reply: "ok"; tooltip: "A separate memory node on a separate ending shard of the same neuron 40, with its own sheet inside (his words 10-28). 10 hits instead of 99."}
      tl: "timeline row: t | R4 > 40.s275 | 41 65" {class: tl}
      b41.s267 -> q1.s268: {class: hop}
      q1.s268 -> q2.s269: {class: hop}
      q2.s269 -> q3.s270: {class: hop}
      q3.s270 -> c4.s122: {class: hop; label: "formula path"}
      c4.s122 -> f70.s266: {class: jump; label: "jump"}
      f70.s266 -> v18.s271: {class: hop}
      v18.s271 -> w43.s272: {class: call}
      f70.s266 -> sub54.s273: {class: call}
      sub54.s273 -> cp44.s274: {class: call}
      w43.s272 -> m: {class: fill; label: "value = 65"}
      cp44.s274 -> m: {class: fill; label: "text"}
      sub54.s273 -> b40.s275: {class: hop}
      b40.s275 -> o60.s276: {class: hop}
      o60.s276 -> m: {class: route; label: "mother > prompt > ok > encoder > reply"}
      m -> tl: {class: trig}
    }
    R6: "R6: born 66" {
      class: col; grid-columns: 1; grid-gap: 14
      b41: "41 · born" {class: neuron; s277: "66 > 67 | - | 51 ask"; tooltip: "The same born neuron, a new shard for this run: arrived from 66. Every run begins with the three questions (his words 10-28), so it goes on to 67 (know). Spawns the ask run (51)."}
      q1: "67 · know (formula neuron)" {class: built; s278: "41 > 68 | - | -"; cell: "born: known"; tooltip: "The question is a jump now: the formula neuron born in lane 2, variables plugged in."}
      q2: "68 · remember (formula neuron)" {class: built; s279: "67 > 69 | - | -"; cell: "memory of a born run: 40.s260"}
      q3: "69 · shape (formula neuron)" {class: built; s280: "69 > 4 | - | -"; cell: "formula proven: 70 > the formula path"; tooltip: "His words 10-28: 'uses the variable formula path or the shortcut path if the variable formula path is not found yet'."}
      c4: "4 · CREATE" {class: hit; s122: "41 > 3 | - | -   jump > 70.s266"; tooltip: "The same shard 4.s122 the long run wrote, now carrying the jump laid by back population: the long run is skipped. 10-08: 'if I know where I am standing I can hop to any point in my brain in one step... all the work was done at learning, not at runtime'."}
      f70: "70 · formula: create table (value)" {class: built; s266: "41 > 18 | 54 substitute | -"; tooltip: "The formula neuron born after R2. Goes on to the value neuron; calls the substitution run."}
      v18: "18 · value" {class: neuron; s281: "70 > 54 | 43 write | -"; tooltip: "A different shard in the value neuron for each new run (his words 10-28): s281 for R6. Its call: the write run writes the value variable, 66, into R6's sheet."}
      w43: "43 · write" {class: neuron; s282: "18 > - | - | -"; tooltip: "Writes value = 66 into R6's sheet cell value ('the formula shortcut is just to the data sheet writing the value variable', his words 10-28)."}
      sub54: "54 · substitute" {class: neuron; s283: "18 > 40 | 44 copy | -"; tooltip: "'substitution run grabbing that value and plugging it into the run data sheet so a new memory node can be made or a new neuron can be made' (his words 10-28). Its call: the copy run copies the formula (R2's sheet cell formula, the receipt with the holes) into this run's sheet; the holes are filled with cell value."}
      cp44: "44 · copy" {class: neuron; s284: "54 > - | - | -"; tooltip: "Copies R2.sheet.formula into R6's sheet cell text ('the trigger of the substitution run copying into the substitution run', his words 10-28)."}
      b40: "40 · build" {class: neuron; s285: "54 > 60 | - | 48 memory"; tooltip: "The build neuron again, a new shard for R6: it ends the run, so it carries another memory node. The build neuron now holds memory nodes for R2, R6, ..."}
      o60: "60 · out" {class: neuron; s286: "40 > - | - | -"; tooltip: "The port: the product and the key (R6 | reply | 40 | t) go to mother."}
      m: "memory node on 40.s285 (R6)" {class: mem; run: "R6"; input: "receipt: 41.s277 67.s278 68.s279 69.s280 4.s122 70.s266 18.s281 54.s283 40.s285 60.s286"; source: "R1 (no gate at 66)"; c_value: "66"; c_text: "> R2.formula with 66 in the holes"; c_reply: "ok"; tooltip: "A separate memory node on a separate ending shard of the same neuron 40, with its own sheet inside (his words 10-28). 10 hits instead of 99."}
      tl: "timeline row: t | R6 > 40.s285 | 41 66" {class: tl}
      b41.s277 -> q1.s278: {class: hop}
      q1.s278 -> q2.s279: {class: hop}
      q2.s279 -> q3.s280: {class: hop}
      q3.s280 -> c4.s122: {class: hop; label: "formula path"}
      c4.s122 -> f70.s266: {class: jump; label: "jump"}
      f70.s266 -> v18.s281: {class: hop}
      v18.s281 -> w43.s282: {class: call}
      f70.s266 -> sub54.s283: {class: call}
      sub54.s283 -> cp44.s284: {class: call}
      w43.s282 -> m: {class: fill; label: "value = 66"}
      cp44.s284 -> m: {class: fill; label: "text"}
      sub54.s283 -> b40.s285: {class: hop}
      b40.s285 -> o60.s286: {class: hop}
      o60.s286 -> m: {class: route; label: "mother > prompt > ok > encoder > reply"}
      m -> tl: {class: trig}
    }
  }
  grow: "7b · NEURONS GAINING SHARDS as the brain grows: the same neuron, many rows, one picked deterministically by before and remainder, and by the modifiers through the inspection run (his words 10-28)" {
    class: lane; grid-columns: 4; grid-gap: 30
    g3: "3 · space after this line" {class: neuron; rows: "227 hits on this line: one row per distinct (before, remainder)"; s115: "64 > 65 | - | -"; s117: "65 > 66 | - | -"; s113: "4 > 5 | - | -  (CREATE > TABLE, the born run)"; more: "and every pair the born run and the return runs crossed"; tooltip: "The space is hit 227 times on this line (the main run, the long born run, the return runs). Each distinct before and remainder is a row; the same pair is the same row hit again, counted (10-22 rev17). The pick is deterministic: before and the remainder head."}
    g18: "18 · value: one shard per run that used the hole" {class: neuron; s127: "6 > 6 | 43 write | -  (R2, statement 1)"; s168: "6 > 3 | 43 write | -  (R2, statement 2)"; s_R4: "70 > 54 | 43 write | -  (R4)"; s_R6: "70 > 54 | 43 write | -  (R6)"; more: "one per newborn of the cascade"; tooltip: "His words 10-28: 'a different shard in the value neuron for each new run'."}
    g40: "40 · build: one ending shard, one memory node, per run it ends" {class: neuron; s260: "10 > 60 | - | 48 memory  (R2)"; s275: "54 > 60 | - | 48 memory  (R4)"; s285: "54 > 60 | - | 48 memory  (R6)"; more: "one per born run of the cascade"; tooltip: "His words 10-28: 'some neuron might have many memory tables because many of their dna shards end runs'."}
    g65: "65 · : three kinds of row, three uses" {class: neuron; s116: "3 > 3 | - | -  (the ask mark, this line)"; s_ret: "168 > 169 | - | -  (inside a definition)"; s_hole: "6 > 18 | - | -  (later: the hole mark in a build run: its SQL action)"; tooltip: "His words 10-28: 'a meaning of the neuron will have many different uses, and or changed meanings based on the modifiers in the script (or sentence)(or context)(or memories) that it encounters'. 10-27 05:37: in sql ':' has an action we know, but a different dna row might not have the same action."}
    g66: "66 · who: rows to come" {class: neuron; s118: "3 > - | - | 48 memory  (define : who)"; s_is: "66 > is | ? | -  (who is ...: a different formula)"; s_are: "66 > are | ? | -"; s_did: "66 > did | ? | -"; s_was: "66 > was | ? | -"; tooltip: "10-22 rev17: 'Who is, who are, who did and who was each fire a different row inside the one neuron for who, and each row points at a different formula: a different place to look, a different thing to read, a different thing to say.' The trigger of each is found by test, not assigned (10-22 rev17)."}
    g4: "4 · CREATE" {class: neuron; s122: "41 > 3 | - | -   jump > 70.s266  (from born)"; s163: "10 > 3 | - | -  (after ; inside the born run)"; s_core: "(its hand-laid rows: the core word function, 10-23 P2 B3)"; tooltip: "10-23 P2 B3: 'create, at certain row, is the core word function... there might be 70 rows that are all core word functions of the word create, versus say word functions of the word create'."}
    pick: "the deterministic pick: before + remainder head; when two rows share them, the inspection run (lane 8) reads the modifiers, the context, the memories and picks" {class: his; tooltip: "His words 10-28."}
  }
}
