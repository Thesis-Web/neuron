    n64: "64 · define" {
      class: col; grid-columns: 1; grid-gap: 14
      dna: "64 · define  DNA" {class: newborn; s114: "1 > 3 | - | -"; tooltip: "One row so far. No trigger yet: define has no action until a formula is taught or learned for it (10-25 msg 51: define : dog = look up definition memory, print)."}
      defn: "definition node of 64" {class: defn; def1: "wn: > return run (…determine the essential qual…)"; def2: "gcide: > return run (…To fix the bounds of; to bri…)"; def3: "mw: > return run (…to determine or identify the…)"; def4: "mw: > return run (…to discover and set forth th…)"; rel5: "like > 78 (delineate)"; rel6: "like > 106 (outline)"; rel7: "like > 107 (silhouette)"; rel8: "like > 108 (sketch)"; rel9: "like > 109 (assign)"; rel10: "like > 110 (baptize)"; rel11: "like > 170 (be characteristic)"; rel12: "like > 113 (explain)"; tooltip: "Rows laid by the compile from the real source lines: wn 1, gcide 1, mw 2 definitions; mwt 4, moby 3, map 1 'like' lines, which are relationship rows: like > the gate of the related symbol (born as it arrived). 10-23 P4: 'any section that can have a relationship to something else is a self-fulfilling relationship section. All of them.'"}
      mem_note: "no memory node yet: no run has ended at 64" {class: note; tooltip: "Memory nodes exist only on shards that end runs (his words 10-28; 10-23 P2 B2)."}
      dna -> defn: {class: readw; label: "born with it"}
    }
    n65: "65 · :" {
      class: col; grid-columns: 1; grid-gap: 14
      dna: "65 · :  DNA" {class: newborn; s116: "3 > 3 | - | -"; s_ret: "168 > 169 | - | -  (from the mw return run)"; tooltip: "Two rows after this line: R1's (space > space) and the mw return run's (that > whoever). Two arrivals, two rows: the pick is by before and remainder (§12 law 13). A third kind of row comes when : is used as the hole mark in a build run. When two rows share one arrival, the call column holds the inspection run (lane 8)."}
      defn: "definition node of 65" {class: defn; def: "guess: the hole mark | confidence c | belief <= 50% (from the guessing brain)"; sqldoc: "0: no source in the slice holds :"; tooltip: "No source in the archived slice answers for ':'. After the step back and the sixth, the guessing brain's guess fills the cell, labeled, and the output asks the user correct?/incorrect?/progression?/degression? (his words 10-28)."}
      dna -> defn: {class: readw}
    }
    n66: "66 · who" {
      class: col; grid-columns: 1; grid-gap: 14
      dna: "66 · who  DNA" {class: newborn; s118: "3 > - | - | 48 memory"; later: "(later: who is, who are, who did, who was: a row each)"; tooltip: "s118 ends R1. 10-22 rev17: who is, who are, who did and who was each fire a different row inside the one neuron for who, each pointing at a different formula. 10-24: 'Go get me some coffee now... me who, coffee what...'."}
      defn: "definition node of 66" {class: defn; def1: "wn: > return run (…a United Nations agency to coo…) [kept apart: the WHO agency]"; def2: "gcide: > return run (…Originally, an interrogative p…)"; def3: "mw: > return run (…what or which person or person…)"; def4: "mw: > return run (…the person or persons that : w…)"; rel1: "? > 146 (whom) named beside who by gcide"; rel2: "? > 169 (whoever) named by mw"; rel3: "? > 149 (person) named by mw"; tooltip: "Rows from the real source lines: wn 1 (the WHO agency, kept apart by the check), gcide 1, mw 2. The relationship rows: the symbols the definitions name beside who; their KIND is not decided here (law 5: no facts from the builder's head)."}
      m1: "memory node on 66.s118 (R1, the main run)" {class: mem; run: "1"; input: "64 3 65 3 66 (receipt rows h1..h5)"; source: "user"; c_clock: "t0"; c_speaker: "user, heard"; c_know: "0 (67)"; c_remember: "0 (68)"; c_shape: "0 (69)"; c_path: "long"; c_gate_64: "64"; c_def_64: "> definition node of 64"; c_gate_65: "65"; c_def_65: "a guess, labeled, confidence c, belief <= 50%"; c_gate_66: "66"; c_def_66: "> definition node of 66"; c_say: "> what was said (R8), the guess labeled"; tooltip: "R1's memory row, on the shard of who that ended it, with the whole data sheet inside (10-26 03:50; his v4 run_sheet). Each cell was declared by the trigger that tripped and filled by a return."}
      m_more: "another run ending at a different shard of who gets its own memory node here" {class: note; tooltip: "His words 10-28: 'some neuron might have many memory tables because many of their dna shards end runs... each will have its own memory table and data runsheet in it'."}
      dna -> defn: {class: readw}
      dna.s118 -> m1: {class: trig; label: "no remainder: 48 memory write run"}
    }
  }
  sources.src64.c52 -> after.n64.defn: {class: fill; label: "lays the rows: first memory"}
  sources.src66.c52 -> after.n66.defn: {class: fill; label: "lays the rows: first memory"}
  sources.src65.sb5 -> after.n65.defn: {class: fill; label: "the guess, labeled"}
  after.n64.defn -> after.n66.m1: {class: fill; label: "def.64"}
  after.n66.defn -> after.n66.m1: {class: fill; label: "def.66"}
  inspect: "8 · THE INSPECTION RUN: a row that decides which row to hit when more than one shard answers the same arrival (10-23 P2 B1; P3 B1). Not called on this line." {
    class: lane; grid-columns: 2; grid-gap: 30
    i1: "the gate" {
      class: col; grid-columns: 1; grid-gap: 14
      gate_x: "a gate with two shards for one before" {class: neuron; sA: "x > y | 46 inspect | -"; sB: "x > z | 46 inspect | -"; tooltip: "When the hop's read by before + remainder head cannot pick one shard, the call column holds the inspection run. 10-23 P2 B1: 'I need to find the noun, or the verb and the noun, or see if there's any adjectives in this sentence, because that determines what row I actually have to hit inside my node... it might go back to that node and hit a different shard'."}
    }
    i2: "the call" {
      class: col; grid-columns: 1; grid-gap: 14
      r46: "46 · read (the inspection run)" {class: neuron; s306: "x > x | 55 compare | -"; tooltip: "1. reads the run's input row: the symbols after and before this gate (10-20 00:31); 2. reads their definition nodes: class, tense, perspective; 3. reads the run's sheet: speaker, what is known, memories; 4. compares; its answer is the shard to hit; 5. returns to the gate, which hits THAT shard (10-23 P3 B1). His words 10-28: 'pick the correct one deterministically such that a meaning of the neuron will have many different uses, and or changed meanings based on the modifiers in the script (or sentence)(or context)(or memories)'."}
      sh: "inspection sheet" {class: sheet; c_after: "gates after"; c_before: "gates before"; c_classes: "from their definition nodes"; c_memories: "from memory nodes"; c_answer: "> the shard to hit"}
    }
    i1.gate_x.sA -> i2.r46: {class: call; label: "call"}
    i2.r46 -> i2.sh: {class: readw}
    i2.sh -> i1.gate_x.sB: {class: call; label: "re-hit that shard"}
  }
  sixth: "11 · THE SIXTH: its own brain; the inner voice that observes or oversees all the runs and asks questions (his words 10-28; 10-23 P2). Reaches the main brain only through mother and its mailbox." {
    class: lane; grid-columns: 3; grid-gap: 30
    sees: "what it sees (through mother, read runs of its own)" {
      class: col; grid-columns: 1; grid-gap: 14
      see1: "the main brain's memory nodes and their sheets" {class: sixth; reads: "every run data sheet: which cells are 0"; tooltip: "His words 10-28: 'your run data sheet at location x,y,z is missing cells'. 10-23 03:18: 'its own questions and prompts from observations basically (sight) of the brain'."}
      see2: "the timeline" {class: sixth; reads: "receipts, the failed choices, what was eliminated"}
      see3: "the DNA rows hit and the receipts" {class: sixth; reads: "which shard was hit, from which arrival"; tooltip: "'am I using the correct dna shard' (his words 10-28)."}
      see4: "anything it cannot see bothers it" {class: his; tooltip: "His words 10-28: 'anything the sixth cannot see should bother it, what did I do there? how did that happen? can I do that on my own?'. So nothing is written by physics the brain cannot read (lane 3)."}
    }
    asks: "its questions: each is a run in sixth.db (its own neurons)" {
      class: col; grid-columns: 1; grid-gap: 14
      a0: "why am I doing it that way?" {class: sixth; run: "sixth.db run 1"; tooltip: "His words 10-28."}
      a1: "is there a better way?" {class: sixth; run: "sixth.db run 2"; tooltip: "His words 10-28; 10-23 P2: 'tries to find more efficient'."}
      a2: "am I using the correct dna shard?" {class: sixth; run: "sixth.db run 3"; tooltip: "His words 10-28."}
      a3: "does that answer seem like progression, balance, make sense? or regression?" {class: sixth; run: "sixth.db run 4"; tooltip: "His words 10-28; 10-23 P5-9 B1: desired vs current vs new."}
      a4: "what data seems wrong that should be corrected?" {class: sixth; run: "sixth.db run 5"; tooltip: "His words 10-28."}
      a5: "what process could be more efficient?" {class: sixth; run: "sixth.db run 6"; tooltip: "His words 10-28."}
      a6: "why did the cell not populate?" {class: sixth; run: "sixth.db run 7"; tooltip: "10-27 03:52."}
      a7: "balance check of the guessing brain's answer against the expected shape of output" {class: sixth; run: "sixth.db run 8"; tooltip: "His words 10-28: 'has its last step or answer checked by another brain for balance of output to expected shape of output'."}
    }
    acts: "what it sends back" {
      class: col; grid-columns: 1; grid-gap: 14
      x1: "answer to a run's 'why?': the missing cells, suggest rerun" {class: mail; tooltip: "His words 10-28: 'the sixth replies your run data sheet at location x,y,z is missing cells ???,???,??? suggest rerun to populate those cells'."}
      x2: "its own line into its mailbox, speaker = sixth: a new run through the same hallway" {class: mail; tooltip: "10-16 05:50: 'at first we would have to prompt these, but later many of these are written by the sixth'. 10-22 rev17: whatever SQL it writes into the main brain is told, not learned."}
      x3: "to the guessing brain: why the guess was wrong, with reasons" {class: mail; tooltip: "10-23 03:18: 'if that word comes back was wrong from the sixth with reasons why it didn't work, then the guessing brain can back prop again over the adjusted corpus'."}
      x1 -> x2: {class: not}
    }
    sees.see1 -> asks.a6: {class: readw}
    asks.a6 -> acts.x1: {class: trig}
    asks.a7 -> acts.x3: {class: trig}
  }
  sources.src65.sb3 -> sixth.asks.a6: {class: route; label: "R5 asks: why?"}
  sixth.acts.x1 -> sources.src65.sb3: {class: route; label: "the reply"}
  guessing: "11b · THE GUESSING BRAIN: a hand-built llm over a small corpus that learns on the fly; every answer a labeled guess with a confidence; belief grows only by use, success and the user's answer (his words 10-28)" {
    class: lane; grid-columns: 3; grid-gap: 30
    parts: "its parts (his words 10-28)" {
      class: col; grid-columns: 1; grid-gap: 14
      p1: "a small corpus, expanded or eliminated by the answers it finds" {class: guess; corpus: "what the main brain sent: the run, the sheet, the sources' nothing"; tooltip: "His words 10-28: 'check state to eliminate answers and expand or eliminate corpus based on the answers it finds'. 10-23 03:18: after a corpus it saves the useful bits, the rest goes to storage in the source db."}
      p2: "context, qkv, weights, hidden layers, back propagation" {class: guess; state: "what it tried before, and why each was wrong"; tooltip: "His words 10-28: 'built more like you, or a llm with qkv, weights, and corpus, hidden layers, back propagation, context, all the things ... the biggest difference is that it's a hand built llm because no llm work this way over a small corpus that can learn on the fly'. 10-23 P5-9: QKV is the guessing piece."}
      p3: "its last step is checked by another brain (the sixth) for balance of output to the expected shape of output" {class: guess; tooltip: "His words 10-28."}
    }
    table: "its answer: a guess, labeled" {
      class: col; grid-columns: 1; grid-gap: 14
      g1: "the guess for def.65" {class: guess; guess: "the hole mark (a reading of : in a build run)"; confidence: "c (its own number)"; belief: "<= 50% on first use, whatever c is"; times_used: "0"; times_solved: "0"; user: "asked: correct? incorrect? progression? degression?"; tooltip: "His words 10-28: 'label the entirety of it's answer as a guess with a confidence factor on the guess... a 99 percent confidence factor on a run that is use for the first time can never have a belief factor of over 50%, and what changes that is the success of the run (actually allows an output) and the response from the user, that guess or this guess seems correct or incorrect.... all guesses in an output are labeled and asked correct?/incorrect?/progression?/degression? <-- that answer is what helps adjust the weights and build the confidence to change a guess into a belief plus the number of times that guess is used and it solves the problem'."}
      g2: "how a guess becomes a belief" {class: his; tooltip: "His words 10-28: the success of the run (it allows an output) + the user's correct/incorrect/progression/degression + the number of times the guess is used and solves the problem. 10-23 P5-9: guesses announced, never lost; 10-15 21:17: 'Always state that this is a guess or belief not known source truth'."}
    }
    loop: "the loop with the sixth" {
      class: col; grid-columns: 1; grid-gap: 14
      l1: "guess > sixth: balance against the expected shape" {class: mail}
      l2: "wrong, with reasons > back prop over the adjusted corpus > guess again until it balances" {class: guess; tooltip: "10-23 03:18."}
      l3: "the guess fills the cell, labeled; the output carries the label and the question to the user" {class: mail}
      l1 -> l2: {class: back; label: "wrong"}
      l2 -> l1: {class: route; label: "again"}
      l1 -> l3: {class: fill; label: "balanced"}
    }
    parts.p2 -> table.g1: {class: trig}
    table.g1 -> loop.l1: {class: route}
  }
  sources.src65.sb5 -> guessing.parts.p1: {class: route; label: "the question, with the key"}
  guessing.loop.l3 -> sources.src65.sb5: {class: fill}
  guessing.loop.l1 -> sixth.asks.a7: {class: route}
  tools: "13 · TOOLS COMPOUND: the hand-laid tools, and what the brain builds from them inside this first run (his words 10-28: tool 1 + tool 2 makes tool 3; the stick, the sharp stick, the sinew, the bow)" {
    class: lane; grid-columns: 3; grid-gap: 30
    hand: "hand laid (the core, lane 0)" {
      class: col; grid-columns: 1; grid-gap: 14
      t46: "46 · read" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t43: "43 · write" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t44: "44 · copy" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t45: "45 · cut" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t55: "55 · compare" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t61: "61 · find" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t42: "42 · hop" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t16: "16 · call" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t17: "17 · spawn" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t47: "47 · clock" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t60: "60 · out (say to mother)" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      tsql: "4..39 · the SQL words and marks" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t41: "41 · born" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
      t40: "40 · build" {class: neuron; tooltip: "A hand-laid tool: its own table, hand-laid DNA rows, a definition node from the SQL docs. His words 10-28: which of these truly must be hand laid is found as the brain grows: 'hand laid that tool is not wrong, but was just out of order'."}
    }
    made: "built by the brain in this run (long runs first, then formula neurons)" {
      class: col; grid-columns: 1; grid-gap: 14
      b67: "67 · know = read + compare + write" {class: built; tooltip: "Built from the hand-laid tools in this run; SQ1 (lane 2). His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b68: "68 · remember = read + compare + write" {class: built; tooltip: "Built from the hand-laid tools in this run; SQ2. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b69: "69 · shape = read + find + compare + write" {class: built; tooltip: "Built from the hand-laid tools in this run; SQ3. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b70: "70 · create table (value) = the SQL words + value + build + out" {class: built; tooltip: "Built from the hand-laid tools in this run; the born run's formula (lane 5). His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b51: "the ask = out + the key" {class: built; tooltip: "Built from the hand-laid tools in this run; lane 6. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b52: "the compile = read + compare + copy + cut + write" {class: built; tooltip: "Built from the hand-laid tools in this run; lane 6. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b53: "the decide formula = read + compare + write" {class: built; tooltip: "Built from the hand-laid tools in this run; lane 5. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b54: "the substitution = copy + write" {class: built; tooltip: "Built from the hand-laid tools in this run; lane 5b. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b48: "the memory write = copy + write" {class: built; tooltip: "Built from the hand-laid tools in this run; lane 9. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b49: "the timeline write = write" {class: built; tooltip: "Built from the hand-laid tools in this run; lane 9. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
      b56: "the say = read the sheet + compare (balance) + out" {class: built; tooltip: "Built from the hand-laid tools in this run; lane 10. His words 10-28: 'use tool 1 to build tool 2 or maybe tool 2 must be handlaid, but tool 1 plus tool 2 might make tool 3, tool 1 minus tool 2 might make tool 4...'."}
    }
    next: "and then (not on this line)" {
      class: col; grid-columns: 1; grid-gap: 14
      n1: "tool 3 * tool 1 - tool 2 = tool 11; tool 11 + tool 1 / tool 7 * tool 2 = tool 12" {class: his; tooltip: "His words 10-28: 'it compounds as it expands... the idea is the handlay the most useful or diverse tools first that the brain can build its tools from'."}
      n2: "the stick, the sharp stick, sinew + rock, sinew + stick + stick, needle + thread, rock + rock + smash, fire + earth, copper + fire + hammer" {class: his; tooltip: "His words 10-28, the metaphor: 'give the nuts and bolts, learn to put the nuts and bolts together in different ways to make the tools that work now, but can be improved later to be the better tools'."}
      n3: "a tool found to be buildable later is not wrong, just out of order" {class: his; tooltip: "His words 10-28: 'as you thought this tool needed to be hand laid but the guessing or sixth or yourself see a different way that could build that tool from inside the brain once something else is built by the brain'."}
    }
    hand.t46 -> made.b67: {class: builtw}
    hand.t55 -> made.b67: {class: builtw}
    hand.t43 -> made.b67: {class: builtw}
    hand.tsql -> made.b70: {class: builtw}
    hand.t40 -> made.b70: {class: builtw}
    hand.t44 -> made.b54: {class: builtw}
    hand.t60 -> made.b51: {class: builtw}
    made.b70 -> next.n1: {class: builtw}
  }
}
