# define : who  -  the whole run from a fresh brain, drawn 2026-10-28 (v2)
# Every neuron is its own table. Numbers only in the tables: gates as the encoder laid them, shards one sequence.
# The words are in the tool pins (hover the i). [his: date] = the owner's words. [reading] = mine, to strike. [open] = his call.
direction: down
grid-columns: 1
grid-gap: 70
vars: { d2-config: { layout-engine: elk } }
classes: {
  lane: {style.fill: "#f8fafc"; style.stroke: "#334155"; style.stroke-width: 2; style.border-radius: 8; style.font-size: 26}
  col: {style.fill: "#ffffff"; style.stroke: "#94a3b8"; style.stroke-width: 1; style.border-radius: 6}
  neuron: {shape: sql_table; style.fill: "#93c5fd"; style.stroke: "#eff6ff"; style.stroke-width: 2}
  hit: {shape: sql_table; style.fill: "#bfdbfe"; style.stroke: "#f8fbff"; style.stroke-width: 1}
  newborn: {shape: sql_table; style.fill: "#f9a8d4"; style.stroke: "#fdf2f8"; style.stroke-width: 2}
  defn: {shape: sql_table; style.fill: "#fde047"; style.stroke: "#fefce8"; style.stroke-width: 2}
  mem: {shape: sql_table; style.fill: "#86efac"; style.stroke: "#f0fdf4"; style.stroke-width: 2}
  sheet: {shape: sql_table; style.fill: "#6ee7b7"; style.stroke: "#ecfdf5"; style.stroke-width: 1}
  tl: {shape: sql_table; style.fill: "#c4b5fd"; style.stroke: "#f5f3ff"; style.stroke-width: 2}
  encoder: {shape: sql_table; style.fill: "#cbd5e1"; style.stroke: "#f8fafc"; style.stroke-width: 2}
  mail: {shape: queue; style.fill: "#e0f2fe"; style.stroke: "#0369a1"}
  mother: {shape: hexagon; style.fill: "#fee2e2"; style.stroke: "#991b1b"; style.stroke-width: 2}
  prompt: {shape: document; style.fill: "#fee2e2"; style.stroke: "#991b1b"}
  src: {shape: package; style.fill: "#ffedd5"; style.stroke: "#c2410c"}
  brain: {shape: package; style.fill: "#ede9fe"; style.stroke: "#7c3aed"; style.stroke-width: 2}
  pick: {shape: diamond; style.fill: "#f1f5f9"; style.stroke: "#334155"}
  note: {style.fill: "#fffbeb"; style.stroke: "#d4a72c"; style.font-size: 14}
  open: {style.fill: "#ffe4e6"; style.stroke: "#be123c"; style.font-size: 14}
  hop: {style.stroke: "#1d4ed8"; style.stroke-width: 3}
  trig: {style.stroke: "#ea580c"; style.stroke-dash: 5; style.stroke-width: 2}
  call: {style.stroke: "#15803d"; style.stroke-dash: 2; style.stroke-width: 2}
  spawn: {style.stroke: "#7c3aed"; style.stroke-dash: 8; style.stroke-width: 2}
  jump: {style.stroke: "#0f172a"; style.stroke-width: 4}
  route: {style.stroke: "#991b1b"; style.stroke-width: 3}
  fill: {style.stroke: "#059669"; style.stroke-dash: 2; style.stroke-width: 2}
  readw: {style.stroke: "#64748b"; style.stroke-dash: 1; style.stroke-width: 1}
  not: {style.stroke: "#94a3b8"; style.stroke-dash: 3; style.stroke-width: 1; style.opacity: 0.6}
}
legend: "KEY" {
  class: lane
  grid-columns: 6
  k_neuron: "NEURON = its own table (61 · define)" {class: neuron; shard: "before > trigger | call | spawn"; tooltip: "A neuron is its own table; its name is its gate (10-19 21:14). Rows are its DNA: his sketch 10-28 gives the columns shard id | before | trigger | call | spawn. The run arrives from before, goes on to trigger, calls side runs that return, spawns runs that leave."}
  k_hit: "one HIT of a gate in a run (the neuron drawn where it is hit)" {class: hit; shard: "before > next"; tooltip: "In a run column every box is one hit of a gate, drawn where the run hits it, as in his sketch (gate 5,6,7 drawn down the column). The row shown is the shard this run hit or wrote."}
  k_newborn: "NEWBORN this line" {class: newborn; tooltip: "A gate that did not exist when the line arrived: born by the born run (10-20 01:22; 10-19 23:40)."}
  k_defn: "DEFINITION NODE (born with the neuron; its first memory)" {class: defn; source: "> return run"; rel: "kind > gate"; tooltip: "10-19 23:40: a new gate, new dna table and new definition node are born at the same time. 10-23 P2: the first birth memory is the definition, pulled from the sources. Its rows: one per source line, and the relationships built from the definition table (10-23 P5-9)."}
  k_mem: "MEMORY NODE on the shard that ended a run (the data sheet inside)" {class: mem; run: "input, source"; cell: "state, value"; tooltip: "10-23 P2 B2: each DNA shard that ends a run will have a memory table for that shard. 10-26 03:50: the data sheet just lives in a cell in the memory row. His v4 brain.db 10-27: run_memory(run, input, source) + run_sheet(run, cell, state, value). A neuron with several shards that end runs has several memory nodes (his words 10-28)."}
  k_tl: "TIMELINE: only a memory table" {class: tl; at: "receipt > memory node, key words"; tooltip: "10-16 06:40: the timeline only gets the receipt number as a pointer, and a couple key words. 10-26 03:50: memory triggers timeline and it just stops because timeline is only a memory table."}
  k_hop: "hop" {style.stroke: "#1d4ed8"; style.stroke-width: 3; tooltip: "The run moves to the remainder's head: before and after; the key is the remainder (§12 law 13). Blue thick wire."}
  k_trig: "trigger" {style.stroke: "#ea580c"; style.stroke-dash: 5; tooltip: "A DNA row excites a run: one, none or many (10-26 05:12). It writes nothing itself; it excites a write, copy or cut run (10-26 03:59). Orange dashed."}
  k_call: "call (returns)" {style.stroke: "#15803d"; style.stroke-dash: 2; tooltip: "A side run whose answer comes back to this run's cell (his sketch: 'call gate 9,8,7' loops back). Green dotted."}
  k_spawn: "spawn (leaves)" {style.stroke: "#7c3aed"; style.stroke-dash: 8; tooltip: "A run that goes off on its own (his sketch: 'spawn gate 5,4,3' leaves). Purple dashed."}
  k_jump: "jump (formula shortcut)" {style.stroke: "#0f172a"; style.stroke-width: 4; tooltip: "Skip the long run: go straight to the formula neuron, plug the value in (10-18 J: 'plug them in and you go to that gate'; his words 10-28: 'skip the long run and use the formula neuron'). Black thick."}
  k_route: "carried by mother" {style.stroke: "#991b1b"; style.stroke-width: 3; tooltip: "Mother routes and traverses, decides nothing, works no data (10-23 P2). Red."}
  k_fill: "a return fills a cell" {style.stroke: "#059669"; style.stroke-dash: 2; tooltip: "10-26 03:50: each return from the graph, from source or from another brain fills its spot on the table. Teal dotted."}
  k_read: "a run reads a table" {style.stroke: "#64748b"; style.stroke-dash: 1; tooltip: "A read run over memory, timeline or definition nodes (standing questions, inspection). Grey dotted."}
  k_not: "not taken on this line" {style.stroke: "#94a3b8"; style.stroke-dash: 3; tooltip: "A path his words describe that this line does not take."}
  k_open: "OPEN: his call" {class: open; tooltip: "What his words leave to him. Listed in the last lane; not filled in."}
}
core: "0 · THE FRESH BRAIN: what is hand laid (his outline 10-25 21:50; v1 10-19)" {
  class: lane
  grid-columns: 4
  grid-gap: 40
  encoder: "ENCODER (the only place a symbol's spelling lives)" {
    class: encoder
    tooltip: "10-26 03:50: 'its a straight database conversion table with x,y,z gates in a sequential order, new word new gate #'. 10-25: 'there are no words in the graph... the encoder encodes to the brain'. The brain holds the numbers; the labels here are the encoder's. Numbers 1..60 are this drawing's numbering of the core, in the order laid."
    g1: "heard"
    g2: "said"
    g3: "space"
    g4: "CREATE"
    g5: "TABLE"
    g6: "\""
    g7: "("
    g8: ")"
    g9: ","
    g10: ";"
    g11: "INTEGER"
    g12: "TEXT"
    g13: "shard"
    g14: "before"
    g15: "trigger"
    g16: "call"
    g17: "spawn"
    g18: "value"
    g19: "definition"
    g20: "source"
    g21: "entry"
    g22: "sense"
    g23: "class"
    g24: "text"
    g25: "example"
    g26: "origin"
    g27: "first_use"
    g28: "synonyms"
    g29: "antonyms"
    g30: "times"
    g31: "first_at"
    g32: "last_at"
    g33: "ended_at"
    g34: "INSERT"
    g35: "INTO"
    g36: "VALUES"
    g37: "SELECT"
    g38: "FROM"
    g39: "WHERE"
    g40: "build"
    g41: "born"
    g42: "hop"
    g43: "write"
    g44: "copy"
    g45: "cut"
    g46: "read"
    g47: "clock"
    g48: "memory"
    g49: "timeline"
    g50: "cell"
    g51: "ask"
    g52: "compile"
    g53: "decide"
    g54: "substitute"
    g55: "formula"
    g56: "say"
    g57: "know"
    g58: "remember"
    g59: "shape"
    g60: "out"
  }
  schemas: "the hand-laid shapes" {
    class: col; grid-columns: 1; grid-gap: 14
  schema_mem: "MEMORY TABLE shape (his own hand, ~/neuron/v4/brain.db, 10-27 01:17)" {
    class: mem
    tooltip: "CREATE TABLE run_memory (run INTEGER PRIMARY KEY, input TEXT NOT NULL, source TEXT NOT NULL); CREATE TABLE run_sheet (run REFERENCES run_memory(run), cell INTEGER, state INTEGER DEFAULT 0 CHECK(state IN (0,1)), value TEXT, PRIMARY KEY(run,cell)). His own typing, 10-27 01:17. The sheet lives inside the memory row (10-26 03:50). One such node per shard that ends a run (10-23 P2 B2)."
    run: "INTEGER PK"; input: "the receipt"; source: "who spoke: user, mother, sixth"; cell: "INTEGER"; state: "0 declared, 1 filled"; value: "what the return put there"
  }
  schema_def: "DEFINITION NODE shape (his own hand, sqlite history)" {
    class: defn
    tooltip: "CREATE TABLE definition (id, neuron, source, entry, sense, class, text, example, origin, first_use, synonyms, antonyms, times, first_at, last_at, ended_at). His own typing. Born with the neuron (10-19 23:40); first memory (10-23 P2); truth shift keeps the old row (10-23 P4: ended_at). Relationships are built from this table and self-populate (10-23 P5-9; P4: opposite, kind of, part, has, plural, past, present, is, same spelling, derived from, used in, prefix, suffix, modifier, mood, rhyming)."
    source: "which source brain answered"; entry: "the headword the source sent"; sense_class: "..."; text: "pointer to the return run (gates)"; synonyms_antonyms: "..."; times_first_last_ended: "truth shift keeps the old row"; rel: "kind > gate (built from the table)"
  }
  schema_tl: "TIMELINE shape" {
    class: tl
    tooltip: "10-16 06:40: 'the timeline only gets the reciept number as a pointer, and a couple key words'. 10-26 03:50: 'timeline is only a memory table, has no dna table ahead of it'. 10-23 P3 B1: reached 'by a trigger hop. Never a sweep'."
    id: "INTEGER PK"; at: "the clock neuron's reading (47)"; receipt: "run > memory node"; key_words: "a few gates"
  }
  }
  outside: "OUTSIDE THE BRAIN" {
    class: col; grid-columns: 1; grid-gap: 14
    grid-columns: 2
    m_user_in: "user > encoder" {class: mail; tooltip: "His outline 10-25 21:50: build the user input mailbox to the encoder. Populated-driven, never a timer (10-22 rev17)."}
    m_mother_in: "mother > encoder (secondary)" {class: mail; tooltip: "His outline: the secondary input mailbox to the encoder from the mother. SQL answers and source answers come back this way (10-24 msg 36)."}
    m_sixth_in: "sixth.db > encoder (third)" {class: mail; tooltip: "His outline: the third input mailbox to the encoder from the sixth.db."}
    m_out: "brain > mother / brain > user (60 out)" {class: mail; tooltip: "His outline: the mailbox output from the brain to the mother and from the brain to the user. Gate 60 is the port neuron the run hits to leave (10-23 msg 1: output to sources is a dna row and trigger to port)."}
    mother: "MOTHER" {class: mother; tooltip: "10-23 P2: the mother is just a router and a traverser. That's it... takes the output and traverses it to the sources, or to another brain, or to its own sql... picks up the outputs of whatever it traversed to and brings it back. She works no data. The name is probably wrong."}
    prompt: "THE NEURON PROMPT (the brain's own sql prompt)" {class: prompt; tooltip: "10-24 msg 36: that output is given to the mother to route to the sql prompt and paste it in the sql prompt and hit enter, wait for the sql response... when mother is done it returns anything from sql output back to the brain as a secondary input. §2.6 his edit 10-24: a string of sql happens as a run put together by the neurons from the run table and outputed as the string to the mother."}
    src_wn: "WordNet" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json, fetched 10-22/10-25): holds 1 line for who (the WHO agency), 1 for define. The brain does not read it: the lines are delivered to the encoder as a run (10-25 msg 37)."}
    src_gcide: "Webster 1913" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json, fetched 10-22/10-25): 1 line for who, 1 for define. The brain does not read it: the lines are delivered to the encoder as a run (10-25 msg 37)."}
    src_mw: "Merriam-Webster" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json, fetched 10-22/10-25): 2 lines for who, 2 for define. The brain does not read it: the lines are delivered to the encoder as a run (10-25 msg 37)."}
    src_mwt: "M-W thesaurus" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json, fetched 10-22/10-25): 4 like-lines for define, none for who. The brain does not read it: the lines are delivered to the encoder as a run (10-25 msg 37)."}
    src_moby: "Moby" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json, fetched 10-22/10-25): 3 like-lines for define, none for who. The brain does not read it: the lines are delivered to the encoder as a run (10-25 msg 37)."}
    src_map: "his relation map" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json, fetched 10-22/10-25): 1 like-line for define, none for who. The brain does not read it: the lines are delivered to the encoder as a run (10-25 msg 37)."}
    src_sqldoc: "SQLite docs" {class: src; tooltip: "A source brain: a database with a corpus, an inbox, an outbox and its own trigger that does its work the moment an ask lands (10-22 rev17). In the archived slice (tries/11 sat172.json, fetched 10-22/10-25): the meaning of the code words to the silicon; nothing for : in this slice. The brain does not read it: the lines are delivered to the encoder as a run (10-25 msg 37)."}
    sixthdb: "sixth.db" {class: brain; tooltip: "10-25 msg 41: create copy brain.db rename to sixth.db run sqlite sixth.db .. update mother for mailbox to sixth, update mailbox pointer in sixth.db. Empty too, on day one."}
    guessdb: "guessing brain" {class: brain; tooltip: "10-23 P5-9: lookup order memory, then state, then sources, then a guess; guesses announced, never lost. 10-23 03:18: the guessing/invention brain... if that word comes back was wrong from the sixth with reasons why it didn't work, then the guessing brain can back prop again over the adjusted corpus and come up with another good guess."}
  }
  notes: "" {
    class: col; grid-columns: 1; grid-gap: 14
  core_note: "the core's own neurons are gates 1..60 (the encoder table, left).\nEach is its own table with hand-laid DNA rows and a definition node\nfed from the SQL docs. Later a core word becomes a row in the real word's neuron." {class: note; tooltip: "10-19 21:20: hand lay a table, then hand lay those same words as nodes so the brain lays its own tables. 10-19 23:03: ( , integer, primary, key... all neurons of their own. 10-23 P2 B3: core words become a row in the DNA of the actual word neuron: create, at certain row, is the core word function. 10-27 05:05: the first core will break the rules... later that should cease to exist when the words and dna and memories, and timeline exist to replace them."}
  }
}
line: "1 · THE LINE ARRIVES: prompt > encoder > brain (10-25: never a told block between)" {
  class: lane
  typed: "user types   define : who" {shape: page; tooltip: "Lands in the user input mailbox (his outline 10-25 21:50)."}
  enc: "encoder: define > 61 (new)   space > 3   : > 62 (new)   space > 3   who > 63 (new)" {class: encoder; tooltip: "A symbol with no gate gets the next number; nothing else is figured here (10-26 03:50; 10-23 P2: the encoder never guesses a word or does work). Who is speaking is part of the input: user, heard (10-26 03:50; §2.1)."}
  r1: "input row R1" {class: sheet; run: "1"; gates: "61 3 62 3 63"; arrival: "1 (heard)"; speaker: "user"; clock: "t0 (47)"; tooltip: "The main run's input row. The clock neuron (47) is hit on every run and its reading goes into the run's meta (10-26 03:50). The remainder is the rest of the line as gate numbers; its head is the key at every gate (10-23 P3)."}
  typed -> enc -> r1
}
sq: "2 · STANDING QUESTIONS: three runs that ask before the main run runs (10-23 P3 B2; his sketch 10-28: three columns)" {
  class: lane
  grid-columns: 4
  q57: "57 · know" {
    class: col; grid-columns: 1; grid-gap: 14
    n: "57 · know" {class: neuron; s101: "1 > - | 46 read | -"; tooltip: "SQ1 'Do I know anything about this?' (10-23 P3 B2). A read run over the gates of the input and their definition nodes. Fresh brain: 61, 62, 63 have no gate. Answer 0. The row: arrived from 1 (heard), spawned from R1’s input row; calls the read run (46); no remainder: the run ends here, so this shard has a memory node."}
    rd: "reads: does a gate exist for 61, 62, 63? do their definition nodes hold rows?" {class: note}
    m: "memory node on 57.s101  (this run)" {class: mem; run: "101"; input: "receipt of the question run"; source: "R1"; c_answer: "0"; tooltip: "The question is a run that ends; its memory row sits on the shard that ended it, with its one-cell sheet inside. Its answer is a cell on R1’s sheet (teal wire)."}
    n.s101 -> rd: {class: readw}
    n.s101 -> m: {class: trig; label: "no remainder"}
  }
  q58: "58 · remember" {
    class: col; grid-columns: 1; grid-gap: 14
    n: "58 · remember" {class: neuron; s102: "1 > - | 46 read | -"; tooltip: "SQ2 'Do I have a memory of this?' (10-23 P3 B2). 10-16: 'have I seen 1+1+1... before, yes on 10/16/26 at 6:15pm the answer was 9... instead of doing the math I just remembered the answer'. Fresh brain: no memory rows. Answer 0. The row: arrived from 1 (heard), spawned from R1’s input row; calls the read run (46); no remainder: the run ends here, so this shard has a memory node."}
    rd: "reads: any memory node with a receipt holding 61 3 62 3 63? any timeline row?" {class: note}
    m: "memory node on 58.s102  (this run)" {class: mem; run: "102"; input: "receipt of the question run"; source: "R1"; c_answer: "0"; tooltip: "The question is a run that ends; its memory row sits on the shard that ended it, with its one-cell sheet inside. Its answer is a cell on R1’s sheet (teal wire)."}
    n.s102 -> rd: {class: readw}
    n.s102 -> m: {class: trig; label: "no remainder"}
  }
  q59: "59 · shape" {
    class: col; grid-columns: 1; grid-gap: 14
    n: "59 · shape" {class: neuron; s103: "1 > - | 46 read | -"; tooltip: "SQ3 'Do I have a shortcut or a formula shortcut?' and his words 10-28: 'does this run shape match another shape I have, so I can know the first formulas to try'. 10-16: 'if no, have I done anything close to that pattern?'. 10-18 J: 'If that gate exists, you go straight to it... plug them in and you go to that gate and you run that run'. Fresh brain: nothing. Answer 0. The row: arrived from 1 (heard), spawned from R1’s input row; calls the read run (46); no remainder: the run ends here, so this shard has a memory node."}
    rd: "reads: timeline receipts with the pattern X 3 62 3 Y? a formula row on gate 61?" {class: note}
    m: "memory node on 59.s103  (this run)" {class: mem; run: "103"; input: "receipt of the question run"; source: "R1"; c_answer: "0"; tooltip: "The question is a run that ends; its memory row sits on the shard that ended it, with its one-cell sheet inside. Its answer is a cell on R1’s sheet (teal wire)."}
    n.s103 -> rd: {class: readw}
    n.s103 -> m: {class: trig; label: "no remainder"}
  }
  path: "which path" {
    class: col; grid-columns: 1; grid-gap: 14
  pick: "all three 0\n> the long way" {class: pick; tooltip: "10-23 P3 B2: 'if they all come back no, then we have to go the long way... yes, we know something, yes, we have a shortcut, and yes, we have a formula shortcut, then we go the formula shortcut path. If the belief and the truth part of that shows that we can do the shortcut path and the formula shortcut path correctly. If not, then we still have to hash out the long way.'"}
  short: "shortcut: one hop to the memory" {class: note; tooltip: "Not taken on this line. 10-23 P3 B2."}
  formula_path: "formula shortcut: plug the cells in,\njump to the formula's gate, run it there" {class: note; tooltip: "Not taken on this line (nothing bound to 61 yet). 10-18 J; 10-23 P3 B2."}
  }
  q57.m -> path.pick: {class: fill}
  q58.m -> path.pick: {class: fill}
  q59.m -> path.pick: {class: fill}
  path.pick -> path.short: {class: not}
  path.pick -> path.formula_path: {class: not}
}
line.r1 -> sq.q57.n: {class: spawn}
line.r1 -> sq.q58.n: {class: spawn}
line.r1 -> sq.q59.n: {class: spawn}
main: "3 · THE MAIN RUN R1, the hallway: 61 > 3 > 62 > 3 > 63 (10-23 P3: it writes nothing but its receipt; the triggers do the rest)" {
  class: lane
  grid-columns: 2
  hall: "the hallway, top to bottom" {
    class: col; grid-columns: 1; grid-gap: 14
  ha: "61 · define" {class: newborn; s104: "1 > 3 | - | -"; tooltip: "define, gate 61, born this line. The row s104: arrived from 1 (heard), goes on to 3 (space). No gate existed: the 'no gate' condition excites the born run (41). Then the write run (43) lays this shard. Its trigger column holds nothing yet: on a fresh brain define is a symbol with no action (10-27 05:37)."}
  hb: "3 · space" {class: neuron; s105: "61 > 62 | - | -"; tooltip: "the space, gate 3, a core neuron. Its action ( ) 'is a meaning that we know happens to the graph or the silicon' (10-27 05:37). No row for (61 > 62): the write run lays s105."}
  hc: "62 · :" {class: newborn; s106: "3 > 3 | - | -"; tooltip: ":, gate 62, born this line. 10-27 05:37: ':' might have an action depending on use; in sql it has an action we know, but a different dna row might not have the same action. On this line it has no action yet. s106: 3 > 3."}
  hd: "3 · space" {class: neuron; s107: "62 > 63 | - | -"; tooltip: "the space again, the same neuron 3, drawn where it is hit the second time (his sketch). s107: 62 > 63."}
  he: "63 · who" {class: newborn; s108: "3 > - | - | 48 memory"; tooltip: "who, gate 63, born this line. s108 has no remainder: 'the dna shard that has no remainder is what triggers the write of the memories' (10-15 21:50). This shard's memory node holds R1's memory row with the sheet inside. Later rows of who: 'who is, who are, who did and who was each fire a different row inside the one neuron for who' (10-22 rev17)."}
  }
  hall.ha.s104 -> hall.hb.s105: {class: hop}
  hall.hb.s105 -> hall.hc.s106: {class: hop}
  hall.hc.s106 -> hall.hd.s107: {class: hop}
  hall.hd.s107 -> hall.he.s108: {class: hop}
  receipt: "R1 receipt" {class: sheet; h1: "1 > 61.s104"; h2: "61 > 3.s105"; h3: "3 > 62.s106"; h4: "62 > 3.s107"; h5: "3 > 63.s108 (end)"; tooltip: "The path of gates and shards the run hit: a pointer to the run, never the run again (10-23 P2). [open] whether the receipt is written by the hop's physics or by a write run (audit 10-25 row 5)."}
  hall.he.s108 -> receipt: {class: readw}
}
sq.path.pick -> main.hall.ha: {class: hop; label: "long way"}
